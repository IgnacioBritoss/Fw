+  if (res.length && res.every((r) => r.total >= 80)) premiarSiNuevo('dia-redondo');
+  const julay = res.find((r) => r.actor.def.id === 'julay');
+  const final = !s.final && d.n >= 21 && julay && julay.total >= 75;
