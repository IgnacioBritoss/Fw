+.cuerpo { min-height: 0; overflow-y: auto; overscroll-behavior: contain; touch-action: pan-y; display: grid; gap: 12px; align-content: start; }
+.dos { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px 20px; }
+.col { display: grid; gap: 10px; align-content: start; min-width: 0; }
+.tarjeta.chica { width: min(420px, 100%); text-align: center; }
+.tarjeta h1 { font-size: clamp(30px, 6vw, 44px); line-height: 1; font-weight: 700; text-align: center; }
