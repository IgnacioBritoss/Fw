+  ctx.restore();
+}
+
+function estante(ctx, id, x, y, t) {
+  if (!id) return;
+  ctx.save();
+  if (id === 'pizarra') {
+    ctx.fillStyle = '#3f4a3c';
+    ctx.beginPath();
+    ctx.roundRect(x - 60, y - 52, 120, 104, 6);
