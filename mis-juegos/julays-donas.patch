+/**
+ * La partida guardada en este dispositivo (localStorage). Se guarda al terminar cada día: si salís
+ * en la mitad, el día empieza de nuevo.
+ */
+import { DECO, DECO_INICIAL, PIELES, PELOS, ROPA } from './data.js';
+
+const KEY = 'julays-donas:partida';
+
+const pick = (a) => a[Math.floor(Math.random() * a.length)];
+
+/** Un personaje al azar para empezar (después se cambia en el vestidor). */
+export function lookAlAzar() {
+  return {
+    skin: Math.floor(Math.random() * PIELES.length),
+    hair: pick(['corto', 'flequillo', 'jopo', 'rulos', 'largo', 'colita', 'rodete', 'trenzas', 'afro']),
+    hairColor: pick(Object.keys(PELOS).filter((k) => !['blanco', 'canoso'].includes(k))),
+    eyes: pick(['punto', 'grande', 'pestanas']),
+    body: 'adulto',
+    shirt: pick(ROPA.slice(0, 6)),
+    pants: '#3b2a20',
+    apron: pick([ROPA[6], ROPA[0], ROPA[1], ROPA[2]]),
+    hat: pick([null, 'panuelo', 'gorra', null]),
+    hatColor: pick(ROPA.slice(0, 6)),
+    glasses: null,
+    beard: null,
+    freckles: Math.random() < 0.3,
+    earrings: false,
+  };
+}
+
+export function partidaNueva(nombre = '', look = lookAlAzar()) {
+  return {
+    v: 1,
+    nombre,
+    look,
+    dia: 1,
+    monedas: 0,
+    deco: { ...DECO_INICIAL },
+    compradas: DECO.filter((d) => d.precio === 0).map((d) => d.id),
+    conocidos: [],
+    logros: [],
+    stats: { atendidos: 0, felices90: 0, mejor: 0, puntos: 0 },
+    postales: [],
+    final: false,
+  };
+}
+
+export function cargar() {
+  try {
+    const s = JSON.parse(localStorage.getItem(KEY));
+    if (s && s.v === 1 && s.look) return { ...partidaNueva(s.nombre, s.look), ...s, look: { ...lookAlAzar(), ...s.look }, deco: { ...DECO_INICIAL, ...s.deco }, stats: { ...partidaNueva().stats, ...s.stats } };
+  } catch {}
+  return null;
+}
+
+export function guardar(s) {
+  try {
+    localStorage.setItem(KEY, JSON.stringify(s));
+  } catch {}
+}
+
+export function borrar() {
+  try {
+    localStorage.removeItem(KEY);
+  } catch {}
+}
