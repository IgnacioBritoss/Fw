+/**
+ * Pantallas en HTML sobre el canvas: título, vestidor (crear tu personaje), historia, inicio y fin
+ * del día, decoración del local, pausa y ayuda.
+ */
+import { C, TXT, PIELES, PELOS, ROPA, HISTORIA, LOGROS, DECO, SLOTS, byId } from './data.js';
+import { persona, retrato, dona, donaIdeal, altoPersona } from './art.js';
+import { icono } from './ticket.js';
+import { salon, mesas, rincon, mostrador, LUGARES } from './local.js';
+import { escena, EW, EH } from './escenas.js';
+import { guardar, lookAlAzar } from './guardado.js';
+import { bonusDeco } from './dia.js';
+import { moneda } from './dibujo.js';
+
+const root = document.getElementById('ui');
+let ultimo = null; // para volver a dibujar si cambia el idioma
+let anim = 0;
+
+const esc = (s) => String(s).replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
+
+function mostrar(html, clase = '') {
+  cancelAnimationFrame(anim);
+  root.innerHTML = `<div class="pantalla ${clase}">${html}</div>`;
+  root.hidden = false;
+  return root.firstElementChild;
+}
+
+export function cerrar() {
+  cancelAnimationFrame(anim);
+  root.hidden = true;
+  root.innerHTML = '';
+  ultimo = null;
+}
+
+export function idioma(J) {
+  if (ultimo) ultimo();
+}
+
+/** Un canvas dentro del HTML, nítido en pantallas de alta densidad. */
+function lienzo(el, w, h, dibujar) {
+  const dpr = Math.min(2, window.devicePixelRatio || 1);
+  el.width = Math.round(w * dpr);
+  el.height = Math.round(h * dpr);
+  el.style.aspectRatio = `${w} / ${h}`;
+  const ctx = el.getContext('2d');
+  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+  ctx.clearRect(0, 0, w, h);
+  dibujar(ctx);
+  return ctx;
+}
+
+function retratoEn(el, look, animo = 'feliz', fondo = C.crema) {
+  lienzo(el, 64, 64, (ctx) => retrato(ctx, look, 32, 32, 29, { animo, fondo }));
+}
+
+const on = (sel, ev, fn) => root.querySelectorAll(sel).forEach((el) => el.addEventListener(ev, fn));
+
+// ---------------------------------------------------------------- título
+
+export function titulo(J, o) {
+  ultimo = () => titulo(J, o);
+  const el = mostrar(
+    `<div class="tarjeta titulo">
+      <canvas class="logo-dona"></canvas>
+      <h1>Julay’s Donas</h1>
+      <p class="bajada">${J.tr({ es: 'Tomá pedidos, armá la masa, freí y decorá. El último cliente del día es el más exigente.', en: 'Take orders, shape the dough, fry and decorate. The last customer of the day is the toughest.' })}</p>
+      <div class="botones">
+        ${o.hayPartida ? `<button class="b primario" data-a="seguir">${J.tr(TXT.seguir)} · ${J.tr(TXT.dia, { d: J.save.dia })}</button>` : ''}
+        <button class="b ${o.hayPartida ? '' : 'primario'}" data-a="nueva">${J.tr(TXT.nueva)}</button>
+        <button class="b" data-a="ayuda">${J.tr(TXT.comoSeJuega)}</button>
+      </div>
+    </div>`,
+    'con-fondo',
+  );
+  const logo = el.querySelector('.logo-dona');
+  let t = 0;
+  const giro = () => {
+    t += 0.016;
+    lienzo(logo, 150, 150, (ctx) => {
+      ctx.translate(75, 75);
+      ctx.rotate(Math.sin(t) * 0.12);
+      dona(ctx, donaIdeal({ masa: 'chocolate', forma: 'anillo', relleno: null, bano: 'frutilla', hilos: 'blanco', toppings: ['granas'], pieza: null }), 0, 0, 62);
+    });
+    anim = requestAnimationFrame(giro);
+  };
+  giro();
+  on('[data-a="seguir"]', 'click', () => o.onSeguir());
+  on('[data-a="nueva"]', 'click', () => o.onNueva());
+  on('[data-a="ayuda"]', 'click', () => ayuda(J, () => titulo(J, o)));
+}
+
+// ---------------------------------------------------------------- vestidor
+
+const ESTILOS = [
+  ['corto', { es: 'Corto', en: 'Short' }],
+  ['flequillo', { es: 'Flequillo', en: 'Bangs' }],
+  ['jopo', { es: 'Jopo', en: 'Quiff' }],
+  ['rulos', { es: 'Rulos', en: 'Curls' }],
+  ['largo', { es: 'Largo', en: 'Long' }],
+  ['colita', { es: 'Colita', en: 'Ponytail' }],
+  ['rodete', { es: 'Rodete', en: 'Bun' }],
+  ['trenzas', { es: 'Trenzas', en: 'Braids' }],
+  ['afro', { es: 'Afro', en: 'Afro' }],
+  ['rapado', { es: 'Rapado', en: 'Buzz cut' }],
+  ['pelado', { es: 'Pelado', en: 'Bald' }],
+];
+const OJOS = [
+  ['punto', { es: 'Puntitos', en: 'Dots' }],
+  ['grande', { es: 'Grandes', en: 'Big' }],
+  ['pestanas', { es: 'Pestañas', en: 'Lashes' }],
+];
+const CARA = [
+  [null, TXT.ninguno],
+  ['bigote', { es: 'Bigote', en: 'Mustache' }],
+  ['barba', { es: 'Barba', en: 'Beard' }],
+  ['candado', { es: 'Candado', en: 'Goatee' }],
+];
+const ANTEOJOS = [
+  [null, TXT.ninguno],
+  ['redondos', { es: 'Redondos', en: 'Round' }],
+  ['cuadrados', { es: 'Cuadrados', en: 'Square' }],
+];
+const GORROS = [
+  [null, TXT.ninguno],
+  ['panuelo', { es: 'Pañuelo', en: 'Bandana' }],
+  ['gorra', { es: 'Gorra', en: 'Cap' }],
+  ['chef', { es: 'De chef', en: 'Chef hat' }],
+  ['boina', { es: 'Boina', en: 'Beret' }],
+];
+
+const PESTANAS = [
+  ['cara', TXT.cara],
+  ['pelo', TXT.pelo],
+  ['ropa', TXT.ropa],
+];
+let pestana = 'cara';
+
+export function creador(J, o, tab = pestana) {
+  // cada opción vuelve a dibujar la pantalla: que la lista no salte arriba
+  const antes = tab === pestana ? root.querySelector('.vestidor .cuerpo')?.scrollTop || 0 : 0;
+  pestana = tab;
+  ultimo = () => creador(J, o, tab);
+  const L = J.save.look;
+  const fila = (titulo, html) => `<div class="fila"><span>${titulo}</span><div class="opciones">${html}</div></div>`;
+  const toggle = (k, n) => `<button class="chip${L[k] ? ' on' : ''}" data-toggle="${k}">${esc(J.tr(n))}</button>`;
+  const chips = (campo, lista) => lista.map(([v, n]) => `<button class="chip${L[campo] === v ? ' on' : ''}" data-campo="${campo}" data-v="${v ?? ''}">${esc(J.tr(n))}</button>`).join('');
+  const colores = (campo, lista) => lista.map((c) => `<button class="color${L[campo] === c ? ' on' : ''}" style="--c:${c}" data-campo="${campo}" data-v="${c}" aria-label="${c}"></button>`).join('');
+  const pieles = PIELES.map((c, i) => `<button class="color${L.skin === i ? ' on' : ''}" style="--c:${c}" data-campo="skin" data-v="${i}" data-num="1" aria-label="${c}"></button>`).join('');
+  const pelos = Object.entries(PELOS).map(([k, c]) => `<button class="color${L.hairColor === k ? ' on' : ''}" style="--c:${c}" data-campo="hairColor" data-v="${k}" aria-label="${k}"></button>`).join('');
+  const filas = {
+    cara: [
+      fila(J.tr(TXT.piel), pieles),
+      fila(J.tr(TXT.ojos), chips('eyes', OJOS)),
+      fila(J.tr(TXT.barba), chips('beard', CARA)),
+      fila(J.tr(TXT.detalles), toggle('freckles', { es: 'Pecas', en: 'Freckles' }) + toggle('earrings', { es: 'Aros', en: 'Earrings' })),
+      fila(J.tr(TXT.anteojos), chips('glasses', ANTEOJOS)),
+    ],
+    pelo: [fila(J.tr(TXT.peinado), chips('hair', ESTILOS)), fila(J.tr(TXT.colorPelo), pelos)],
+    ropa: [
+      fila(J.tr(TXT.remera), colores('shirt', ROPA)),
+      fila(J.tr(TXT.delantal), colores('apron', ROPA)),
+      fila(J.tr(TXT.sombrero), chips('hat', GORROS)),
+      L.hat && L.hat !== 'chef' ? fila(J.tr(TXT.colorGorro), colores('hatColor', ROPA.slice(0, 8))) : '',
+    ],
+  };
+  const el = mostrar(
+    `<div class="tarjeta vestidor">
+      <div class="vista">
+        <canvas class="persona"></canvas>
+        <label class="nombre"><span>${J.tr(TXT.tuNombre)}</span><input maxlength="14" value="${esc(J.save.nombre || '')}" placeholder="${J.lang === 'es' ? 'Ej: Juli' : 'E.g. Jules'}"></label>
+      </div>
+      <div class="ajustes">
+        <h2>${J.tr(o.volver ? TXT.vestidor : TXT.quienSos)}</h2>
