+.items { position: absolute; inset: 0; display: grid; gap: 8px; align-content: start; overflow-y: auto; overscroll-behavior: contain; touch-action: pan-y; padding-right: 4px; }
+.item { display: flex; align-items: center; justify-content: space-between; gap: 10px; background: #fff8ec; border: 2.5px solid var(--tinta); border-radius: 14px; padding: 8px 10px 8px 14px; cursor: pointer; }
+.item.prueba { border-color: var(--terracota); background: #fbeae2; }
