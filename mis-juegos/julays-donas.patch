+.tarjeta h3 { font-size: 15px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--tinta2); }
+.bajada { font-size: 17px; text-align: center; color: var(--tinta2); line-height: 1.35; }
+.botones { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; align-items: center; padding-bottom: 5px; }
+.botones.columna { flex-direction: column; align-items: stretch; }
+
+.b { font: 700 19px var(--fuente); color: var(--tinta); background: var(--crema); border: 3px solid var(--tinta); border-radius: 14px; padding: 11px 20px; cursor: pointer; box-shadow: 0 5px 0 #c9b79c; transition: transform 0.08s, box-shadow 0.08s; }
+.b:active:not(:disabled) { transform: translateY(3px); box-shadow: 0 2px 0 #c9b79c; }
+.b.primario { background: var(--terracota); color: var(--crema); box-shadow: 0 5px 0 #8c3a28; }
