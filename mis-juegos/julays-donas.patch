+.b.chico.primario { box-shadow: 0 3px 0 #8c3a28; }
+.chip { font: 600 15px var(--fuente); color: var(--tinta); background: var(--crema); border: 2.5px solid var(--tinta); border-radius: 99px; padding: 6px 12px; cursor: pointer; }
