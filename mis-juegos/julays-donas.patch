@@ -0,0 +1,1350 @@
+/**
+ * Dibujo con canvas (sin imágenes): donas en todos sus estados, personas personalizables e íconos.
+ * Todo se dibuja con colores lisos y un contorno marrón, como un dibujo animado.
+ */
+import { C, PIELES, PELOS, MASAS, BANOS, HILOS, TOPPINGS, PIEZAS, RELLENOS, byId } from './data.js';
+import { GEOM } from './geom.js';
+
+export const TAU = Math.PI * 2;
+
+// ------------------------------------------------------------------ colores
+
+const rgb = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
+const hex = (a) => '#' + a.map((v) => Math.round(Math.max(0, Math.min(255, v))).toString(16).padStart(2, '0')).join('');
+
+/** Mezcla de dos colores (t = 0 → a, t = 1 → b). */
+export function mix(a, b, t) {
+  const A = rgb(a);
+  const B = rgb(b);
+  return hex(A.map((v, i) => v + (B[i] - v) * t));
+}
+/** Más oscuro (k < 0) o más claro (k > 0), de -1 a 1. */
+export const tono = (c, k) => (k < 0 ? mix(c, '#2a1d15', -k) : mix(c, '#fffaf2', k));
+export const alfa = (c, a) => {
+  const [r, g, b] = rgb(c);
+  return `rgba(${r},${g},${b},${a})`;
+};
+
+/** Números al azar pero siempre los mismos para la misma semilla (para que una dona no "tiemble"). */
+export function azar(semilla) {
+  let s = (semilla * 9301 + 49297) % 233280 || 1;
+  return () => {
+    s = (s * 16807) % 2147483647;
+    return (s - 1) / 2147483646;
+  };
+}
+
+// ------------------------------------------------------------------ formas de dona
+
+/** Arma el camino de la forma (para rellenar o recortar). k achica la forma hacia adentro. */
+export function caminoForma(ctx, forma, x, y, r, k = 1) {
+  const g = GEOM[forma];
+  ctx.beginPath();
+  if (forma === 'baston') {
+    const h = g.h * r * k;
+    const l = (g.w - g.h) * r;
+    ctx.moveTo(x - l, y - h);
+    ctx.lineTo(x + l, y - h);
+    ctx.arc(x + l, y, h, -Math.PI / 2, Math.PI / 2);
+    ctx.lineTo(x - l, y + h);
+    ctx.arc(x - l, y, h, Math.PI / 2, (3 * Math.PI) / 2);
+    ctx.closePath();
+    return;
+  }
+  ctx.arc(x, y, g.w * r * k, 0, TAU);
+  if (g.hueco) {
+    const ri = g.hueco * r * (2 - k);
+    ctx.moveTo(x + ri, y);
+    ctx.arc(x, y, ri, 0, TAU, true);
+  }
+}
+
+/** Color de la masa según cuánto se frió (0 crudo, 1 dorado, 1.3 tostado, 1.7 quemado). */
+export function colorMasa(masaId, c) {
+  const m = byId(MASAS, masaId) || MASAS[0];
+  if (c <= 1) return mix(m.crudo, m.dorado, Math.max(0, c));
+  if (c <= 1.3) return mix(m.dorado, m.tostado, (c - 1) / 0.3);
+  return mix(m.tostado, m.quemado, Math.min(1, (c - 1.3) / 0.4));
+}
+
+/** Puntos del borde de un baño (en unidades de r), con ondas y gotas que caen. */
+function bordeBano(forma, cob, semilla) {
+  const g = GEOM[forma];
+  const R = azar(semilla);
+  const gotas = [];
+  const nG = 5 + Math.floor(R() * 3);
+  for (let i = 0; i < nG; i++) gotas.push({ t: R(), largo: 0.05 + R() * 0.07 });
+  const fase = R() * TAU;
+  const lleno = Math.min(1, cob);
+  const extra = Math.max(0, cob - 1);
+  const pts = [];
+  const N = 90;
+  for (let i = 0; i < N; i++) {
+    const t = i / N;
+    let px;
+    let py;
+    let nx;
+    let ny;
+    if (forma === 'baston') {
+      // perímetro de la cápsula, recorrido con t
+      const l = g.w - g.h;
+      const hh = g.h * (0.35 + 0.57 * Math.pow(lleno, 0.7));
+      const per = 4 * l + TAU * hh;
+      let s = t * per;
+      if (s < 2 * l) {
+        px = -l + s;
+        py = -hh;
+        nx = 0;
+        ny = -1;
+      } else if ((s -= 2 * l) < Math.PI * hh) {
+        const a = -Math.PI / 2 + s / hh;
+        px = l + Math.cos(a) * hh;
+        py = Math.sin(a) * hh;
+        nx = Math.cos(a);
+        ny = Math.sin(a);
+      } else if ((s -= Math.PI * hh) < 2 * l) {
+        px = l - s;
+        py = hh;
+        nx = 0;
+        ny = 1;
+      } else {
+        s -= 2 * l;
+        const a = Math.PI / 2 + s / hh;
+        px = -l + Math.cos(a) * hh;
+        py = Math.sin(a) * hh;
+        nx = Math.cos(a);
+        ny = Math.sin(a);
+      }
+    } else {
+      const a = t * TAU;
+      const ri = g.hueco ? g.hueco + 0.05 : 0;
+      const ro = ri + (g.w * 0.93 - ri) * Math.pow(lleno, g.hueco ? 0.8 : 0.6);
+      px = Math.cos(a) * ro;
+      py = Math.sin(a) * ro;
+      nx = Math.cos(a);
+      ny = Math.sin(a);
+    }
+    let d = 0.022 * Math.sin(t * TAU * 9 + fase) * lleno;
+    if (lleno > 0.85)
+      for (const gt of gotas) {
+        const dt = Math.min(Math.abs(t - gt.t), 1 - Math.abs(t - gt.t));
+        d += (gt.largo + extra * 0.12) * Math.exp(-((dt * 26) ** 2)) * (lleno - 0.85) * 6.6;
+      }
+    pts.push([px + nx * d, py + ny * d]);
+  }
+  return pts;
+}
+
+// ------------------------------------------------------------------ toppings y piezas
+
+/** Dibuja una partícula de topping (en píxeles, ya ubicada). */
+function particula(ctx, tipo, color, s, a) {
+  ctx.fillStyle = color;
+  if (tipo === 'grana') {
+    ctx.rotate(a);
+    ctx.beginPath();
+    ctx.roundRect(-s * 0.9, -s * 0.28, s * 1.8, s * 0.56, s * 0.28);
+    ctx.fill();
+  } else if (tipo === 'hebra') {
+    ctx.rotate(a);
+    ctx.fillRect(-s * 0.8, -s * 0.13, s * 1.6, s * 0.26);
+  } else if (tipo === 'trozo') {
+    ctx.rotate(a);
+    ctx.beginPath();
+    ctx.moveTo(-s * 0.5, -s * 0.35);
+    ctx.lineTo(s * 0.45, -s * 0.45);
+    ctx.lineTo(s * 0.55, s * 0.3);
+    ctx.lineTo(-s * 0.3, s * 0.5);
+    ctx.closePath();
+    ctx.fill();
+  } else if (tipo === 'gota') {
+    ctx.rotate(a);
+    ctx.beginPath();
+    ctx.moveTo(0, -s * 0.6);
+    ctx.quadraticCurveTo(s * 0.55, s * 0.2, 0, s * 0.45);
+    ctx.quadraticCurveTo(-s * 0.55, s * 0.2, 0, -s * 0.6);
+    ctx.fill();
+  } else {
+    ctx.beginPath();
+    ctx.arc(0, 0, s * 0.22, 0, TAU);
+    ctx.fill();
+  }
+}
+
+/** Una pieza (frutilla, merenguito, confite, cereza) centrada en 0,0 con tamaño s. */
+export function pieza(ctx, id, s, a = 0, k = 0) {
+  ctx.save();
+  ctx.lineWidth = Math.max(1, s * 0.09);
+  ctx.strokeStyle = C.tinta;
+  if (id === 'frutilla') {
+    ctx.rotate(a);
+    ctx.fillStyle = '#c8443c';
+    ctx.beginPath();
+    ctx.moveTo(0, s * 0.62);
+    ctx.bezierCurveTo(-s * 0.75, s * 0.1, -s * 0.55, -s * 0.5, 0, -s * 0.36);
+    ctx.bezierCurveTo(s * 0.55, -s * 0.5, s * 0.75, s * 0.1, 0, s * 0.62);
+    ctx.fill();
+    ctx.stroke();
+    ctx.fillStyle = '#f2d68a';
+    for (const [x, y] of [[-0.2, -0.05], [0.18, -0.08], [0, 0.18], [-0.12, 0.32], [0.14, 0.3]]) {
+      ctx.beginPath();
+      ctx.ellipse(x * s, y * s, s * 0.04, s * 0.06, 0, 0, TAU);
+      ctx.fill();
+    }
+    ctx.fillStyle = '#6a994e';
+    ctx.beginPath();
+    for (let i = 0; i < 5; i++) {
+      const b = -Math.PI / 2 + (i - 2) * 0.55;
+      ctx.ellipse(Math.cos(b) * s * 0.12, -s * 0.38 + Math.sin(b) * s * 0.12, s * 0.16, s * 0.07, b, 0, TAU);
+    }
+    ctx.fill();
+  } else if (id === 'merengue') {
+    ctx.fillStyle = '#fbf3e6';
+    for (const [y, r] of [[0.2, 0.46], [-0.08, 0.34], [-0.32, 0.2]]) {
+      ctx.beginPath();
+      ctx.arc(0, y * s, r * s, 0, TAU);
+      ctx.fill();
+      ctx.stroke();
+    }
+    ctx.beginPath();
+    ctx.moveTo(0, -s * 0.5);
+    ctx.lineTo(s * 0.06, -s * 0.62);
+    ctx.stroke();
+  } else if (id === 'confite') {
+    const cols = ['#c8553d', '#d4a017', '#6a994e', '#2f6690', '#c47a8a', '#7b4b94'];
+    ctx.fillStyle = cols[k % cols.length];
+    ctx.beginPath();
+    ctx.ellipse(0, 0, s * 0.42, s * 0.34, a, 0, TAU);
+    ctx.fill();
+    ctx.stroke();
+    ctx.fillStyle = 'rgba(255,250,242,.55)';
+    ctx.beginPath();
+    ctx.ellipse(-s * 0.12, -s * 0.1, s * 0.12, s * 0.07, -0.5, 0, TAU);
+    ctx.fill();
+  } else {
+    // cereza
+    ctx.strokeStyle = '#5b7a3a';
+    ctx.lineWidth = Math.max(1, s * 0.08);
+    ctx.beginPath();
+    ctx.moveTo(0, -s * 0.15);
+    ctx.quadraticCurveTo(s * 0.1, -s * 0.55, s * 0.32, -s * 0.66);
+    ctx.stroke();
+    ctx.strokeStyle = C.tinta;
+    ctx.lineWidth = Math.max(1, s * 0.09);
+    ctx.fillStyle = '#a8232f';
+    ctx.beginPath();
+    ctx.arc(0, s * 0.1, s * 0.36, 0, TAU);
+    ctx.fill();
+    ctx.stroke();
+    ctx.fillStyle = 'rgba(255,250,242,.5)';
+    ctx.beginPath();
+    ctx.arc(-s * 0.12, -s * 0.02, s * 0.09, 0, TAU);
+    ctx.fill();
+  }
+  ctx.restore();
+}
+
+// ------------------------------------------------------------------ dona ideal (para tickets)
+
+const ideales = new Map();
+
+/** Una dona "como la pide el ticket", con toppings y piezas generados, para mostrarla dibujada. */
+export function donaIdeal(spec) {
+  const key = JSON.stringify(spec);
+  if (ideales.has(key)) return ideales.get(key);
+  const R = azar(key.length * 31 + key.charCodeAt(5) + key.charCodeAt(key.length - 3));
+  const d = { id: Math.floor(R() * 1e6), masa: spec.masa, forma: spec.forma, coc: [1, 1], relleno: spec.relleno ? { id: spec.relleno, cant: 1 } : null, bano: spec.bano ? { id: spec.bano, cob: 1 } : null, lineas: [], parts: [], piezas: [] };
+  const g = GEOM[spec.forma];
+  if (spec.hilos) {
+    // zigzag de punta a punta
+    const pts = [];
+    const n = spec.forma === 'baston' ? 9 : 7;
+    for (let i = 0; i <= n; i++) {
+      const x = -g.w * 0.85 + ((g.w * 1.7) / n) * i;
+      pts.push(x, (i % 2 ? 1 : -1) * g.h * 0.75);
+    }
+    d.lineas.push({ id: spec.hilos, pts });
+  }
+  for (const t of spec.toppings) {
+    const tp = byId(TOPPINGS, t);
+    const n = t === 'azucar' ? 260 : 70;
+    for (let i = 0; i < n; i++) {
+      const x = (R() * 2 - 1) * g.w;
+      const y = (R() * 2 - 1) * g.h;
+      d.parts.push({ id: t, x, y, a: R() * TAU, k: Math.floor(R() * tp.colores.length), s: 0.8 + R() * 0.4 });
+    }
+  }
+  if (spec.pieza) {
+    const n = spec.pieza.n;
+    for (let i = 0; i < n; i++) {
+      if (spec.forma === 'baston') d.piezas.push({ id: spec.pieza.id, x: -g.w * 0.7 + ((g.w * 1.4) / Math.max(1, n - 1)) * i, y: 0, a: 0, k: i });
+      else {
+        const a = (i / n) * TAU - Math.PI / 2;
+        const rr = g.hueco ? (g.w + g.hueco) / 2 : 0.55;
+        d.piezas.push({ id: spec.pieza.id, x: Math.cos(a) * rr, y: Math.sin(a) * rr, a: a + Math.PI / 2, k: i });
+      }
+    }
+  }
+  ideales.set(key, d);
+  return d;
+}
+
+// ------------------------------------------------------------------ dona
+
+/**
+ * Dibuja una dona vista desde arriba en (x, y) con radio r (píxeles).
+ * o.lado: qué lado se ve (al freír); si no, se ve el lado que se frió primero.
+ * o.lod: 'baja' para íconos chiquitos (menos detalle). o.sombra: sombra abajo.
+ */
+export function dona(ctx, d, x, y, r, o = {}) {
+  const forma = d.forma;
+  const g = GEOM[forma];
+  const lado = o.lado ?? 0;
+  const c = d.coc ? d.coc[lado] : 1;
+  const baja = o.lod === 'baja' || r < 26;
+  const hincha = d.relleno ? 1 + 0.05 * Math.min(1.3, d.relleno.cant) : 1;
+  const rr = r * hincha;
+  ctx.save();
+  // sombra
+  if (o.sombra !== false) {
+    ctx.fillStyle = 'rgba(59,42,32,.18)';
+    ctx.beginPath();
+    ctx.ellipse(x + r * 0.05, y + rr * g.h * 0.32 + r * 0.1, rr * g.w * 0.98, rr * g.h * 0.85, 0, 0, TAU);
+    ctx.fill();
+  }
+  // masa
+  const base = colorMasa(d.masa, c);
+  caminoForma(ctx, forma, x, y, rr);
+  ctx.fillStyle = base;
+  ctx.fill('evenodd');
+  // sombreado: borde más oscuro y un brillo arriba a la izquierda
+  ctx.save();
+  caminoForma(ctx, forma, x, y, rr);
+  ctx.clip('evenodd');
+  ctx.lineWidth = rr * 0.16;
+  ctx.strokeStyle = alfa(tono(base, -0.35), 0.35);
+  caminoForma(ctx, forma, x, y, rr);
+  ctx.stroke();
+  if (d.coc && d.coc[1 - lado] !== undefined && o.lado === undefined) {
+    // el borde deja ver el otro lado
+    ctx.lineWidth = rr * 0.07;
+    ctx.strokeStyle = alfa(colorMasa(d.masa, d.coc[1]), 0.85);
+    caminoForma(ctx, forma, x, y, rr);
+    ctx.stroke();
+  }
+  ctx.fillStyle = 'rgba(255,250,242,.22)';
+  ctx.beginPath();
+  ctx.ellipse(x - rr * g.w * 0.35, y - rr * g.h * 0.42, rr * g.w * 0.32, rr * g.h * 0.16, -0.5, 0, TAU);
+  ctx.fill();
+  if (!baja && c < 0.7) {
+    // poros de la masa cruda
+    const R = azar((d.id || 7) + 3);
+    ctx.fillStyle = alfa(tono(base, 0.4), 0.5);
+    for (let i = 0; i < 26; i++) {
+      const px = (R() * 2 - 1) * g.w;
+      const py = (R() * 2 - 1) * g.h;
+      ctx.beginPath();
+      ctx.arc(x + px * rr, y + py * rr, rr * 0.022, 0, TAU);
+      ctx.fill();
+    }
+  }
+  if (c > 1.42) {
+    // manchas de quemado
+    const R = azar((d.id || 7) + 11);
+    ctx.fillStyle = alfa('#1c110b', Math.min(0.55, (c - 1.42) * 1.5));
+    for (let i = 0; i < 9; i++) {
+      ctx.beginPath();
+      ctx.ellipse(x + (R() * 2 - 1) * g.w * rr * 0.8, y + (R() * 2 - 1) * g.h * rr * 0.8, rr * 0.1, rr * 0.06, R() * 3, 0, TAU);
+      ctx.fill();
+    }
+  }
+  ctx.restore();
+
+  // relleno: el agujerito por donde entró la manga (y si te pasaste, se sale)
+  if (d.relleno && forma !== 'anillo') {
+    const rel = byId(RELLENOS, d.relleno.id);
+    const hx = x + rr * g.w * 0.72;
+    const hy = y - rr * g.h * 0.5;
+    if (d.relleno.cant > 1.1) {
+      ctx.fillStyle = rel.color;
+      ctx.beginPath();
+      ctx.ellipse(hx + rr * 0.1, hy - rr * 0.04, rr * (0.08 + 0.12 * Math.min(1, d.relleno.cant - 1.1)), rr * 0.07, -0.4, 0, TAU);
+      ctx.fill();
+    }
+    ctx.fillStyle = tono(rel.color, -0.3);
+    ctx.beginPath();
+    ctx.ellipse(hx, hy, rr * 0.05, rr * 0.035, -0.4, 0, TAU);
+    ctx.fill();
+  }
+
+  // baño
+  if (d.bano && d.bano.cob > 0.02) {
+    const b = byId(BANOS, d.bano.id);
+    const pts = bordeBano(forma, d.bano.cob, (d.id || 1) * 7 + 1);
+    ctx.save();
+    ctx.beginPath();
+    pts.forEach(([px, py], i) => (i ? ctx.lineTo(x + px * rr, y + py * rr) : ctx.moveTo(x + px * rr, y + py * rr)));
+    ctx.closePath();
+    if (g.hueco) {
+      const ri = (g.hueco + 0.04) * rr;
+      ctx.moveTo(x + ri, y);
+      ctx.arc(x, y, ri, 0, TAU, true);
+    }
+    ctx.fillStyle = b.color;
+    ctx.fill('evenodd');
+    ctx.lineWidth = Math.max(1, rr * 0.025);
+    ctx.strokeStyle = alfa(tono(b.color, -0.45), 0.6);
+    ctx.stroke();
+    // brillo del baño
+    ctx.fillStyle = alfa(b.brillo, 0.75);
+    ctx.beginPath();
+    if (forma === 'baston') ctx.ellipse(x - rr * 0.5, y - rr * g.h * 0.45, rr * 0.45, rr * 0.07, -0.08, 0, TAU);
+    else ctx.ellipse(x - rr * 0.38, y - rr * 0.42, rr * 0.22, rr * 0.07, -0.75, 0, TAU);
+    ctx.fill();
+    ctx.restore();
+  }
+
+  // hilos y toppings: recortados a la dona
+  if ((d.lineas && d.lineas.length) || (d.parts && d.parts.length)) {
+    ctx.save();
+    caminoForma(ctx, forma, x, y, rr);
+    ctx.clip('evenodd');
+    for (const ln of d.lineas || []) {
+      const h = byId(HILOS, ln.id);
+      if (!h || ln.pts.length < 4) continue;
+      ctx.lineCap = 'round';
+      ctx.lineJoin = 'round';
+      ctx.lineWidth = rr * 0.075;
+      ctx.strokeStyle = alfa(tono(h.color, -0.35), 0.5);
+      ctx.beginPath();
+      for (let i = 0; i < ln.pts.length; i += 2) {
+        const px = x + ln.pts[i] * rr;
+        const py = y + ln.pts[i + 1] * rr + rr * 0.012;
+        i ? ctx.lineTo(px, py) : ctx.moveTo(px, py);
+      }
+      ctx.stroke();
+      ctx.lineWidth = rr * 0.058;
+      ctx.strokeStyle = h.color;
+      ctx.stroke();
+    }
+    const paso = baja ? 3 : 1;
+    for (let i = 0; i < (d.parts || []).length; i += paso) {
+      const p = d.parts[i];
+      const tp = byId(TOPPINGS, p.id);
+      if (!tp) continue;
+      ctx.save();
+      ctx.translate(x + p.x * rr, y + p.y * rr);
+      particula(ctx, tp.forma, tp.colores[p.k % tp.colores.length], rr * 0.055 * (p.s || 1) * (baja ? 1.4 : 1), p.a);
+      ctx.restore();
+    }
+    ctx.restore();
+  }
+
+  // contorno
+  ctx.lineWidth = Math.max(1.2, r * 0.04);
+  ctx.strokeStyle = C.tinta;
+  caminoForma(ctx, forma, x, y, rr);
+  ctx.stroke();
+
+  // piezas, arriba de todo
+  for (const p of d.piezas || []) {
+    ctx.save();
+    ctx.translate(x + p.x * rr, y + p.y * rr);
+    pieza(ctx, p.id, rr * 0.2, p.a || 0, p.k || 0);
+    ctx.restore();
+  }
+  ctx.restore();
+}
+
+// ------------------------------------------------------------------ íconos chiquitos
+
+/** Bolsita de manga (relleno). */
+export function iconoManga(ctx, color, x, y, s) {
+  ctx.save();
+  ctx.translate(x, y);
+  ctx.lineWidth = Math.max(1.2, s * 0.07);
+  ctx.strokeStyle = C.tinta;
+  ctx.fillStyle = '#f6f0e6';
+  ctx.beginPath();
+  ctx.moveTo(-s * 0.45, -s * 0.5);
+  ctx.lineTo(s * 0.45, -s * 0.5);
+  ctx.lineTo(s * 0.08, s * 0.38);
+  ctx.lineTo(-s * 0.08, s * 0.38);
+  ctx.closePath();
+  ctx.fill();
+  ctx.stroke();
+  ctx.fillStyle = color;
+  ctx.beginPath();
+  ctx.moveTo(-s * 0.33, -s * 0.2);
+  ctx.lineTo(s * 0.33, -s * 0.2);
+  ctx.lineTo(s * 0.08, s * 0.36);
+  ctx.lineTo(-s * 0.08, s * 0.36);
+  ctx.closePath();
+  ctx.fill();
+  ctx.fillStyle = C.acero;
+  ctx.fillRect(-s * 0.07, s * 0.36, s * 0.14, s * 0.16);
+  ctx.strokeRect(-s * 0.07, s * 0.36, s * 0.14, s * 0.16);
+  ctx.restore();
+}
+
+/** Bowl con baño. */
+export function iconoBowl(ctx, color, x, y, s) {
+  ctx.save();
+  ctx.translate(x, y);
+  ctx.lineWidth = Math.max(1.2, s * 0.07);
+  ctx.strokeStyle = C.tinta;
+  ctx.fillStyle = color;
+  ctx.beginPath();
+  ctx.ellipse(0, -s * 0.12, s * 0.5, s * 0.16, 0, 0, TAU);
+  ctx.fill();
+  ctx.fillStyle = '#ece4d6';
+  ctx.beginPath();
+  ctx.moveTo(-s * 0.55, -s * 0.12);
+  ctx.quadraticCurveTo(-s * 0.5, s * 0.45, 0, s * 0.45);
+  ctx.quadraticCurveTo(s * 0.5, s * 0.45, s * 0.55, -s * 0.12);
+  ctx.closePath();
+  ctx.fill();
+  ctx.stroke();
+  ctx.beginPath();
+  ctx.ellipse(0, -s * 0.12, s * 0.55, s * 0.18, 0, 0, TAU);
+  ctx.stroke();
+  ctx.fillStyle = color;
+  ctx.beginPath();
+  ctx.ellipse(0, -s * 0.1, s * 0.46, s * 0.13, 0, 0, TAU);
+  ctx.fill();
+  ctx.restore();
+}
+
+/** Pomo de hilos. */
+export function iconoPomo(ctx, color, x, y, s) {
+  ctx.save();
+  ctx.translate(x, y);
+  ctx.rotate(0.35);
+  ctx.lineWidth = Math.max(1.2, s * 0.07);
+  ctx.strokeStyle = C.tinta;
+  ctx.fillStyle = color;
+  ctx.beginPath();
+  ctx.roundRect(-s * 0.22, -s * 0.38, s * 0.44, s * 0.7, s * 0.12);
+  ctx.fill();
+  ctx.stroke();
+  ctx.fillStyle = '#f6f0e6';
+  ctx.beginPath();
+  ctx.moveTo(-s * 0.13, -s * 0.38);
+  ctx.lineTo(s * 0.13, -s * 0.38);
+  ctx.lineTo(0, -s * 0.62);
+  ctx.closePath();
+  ctx.fill();
+  ctx.stroke();
+  ctx.fillStyle = 'rgba(255,250,242,.6)';
+  ctx.fillRect(-s * 0.12, -s * 0.2, s * 0.24, s * 0.12);
+  ctx.restore();
+}
+
+/** Salero / frasco de toppings. */
+export function iconoSalero(ctx, tp, x, y, s) {
+  ctx.save();
+  ctx.translate(x, y);
+  ctx.lineWidth = Math.max(1.2, s * 0.07);
+  ctx.strokeStyle = C.tinta;
+  ctx.fillStyle = 'rgba(246,240,230,.92)';
+  ctx.beginPath();
+  ctx.roundRect(-s * 0.3, -s * 0.28, s * 0.6, s * 0.72, s * 0.12);
+  ctx.fill();
+  ctx.stroke();
+  ctx.fillStyle = C.acero;
+  ctx.beginPath();
+  ctx.roundRect(-s * 0.32, -s * 0.48, s * 0.64, s * 0.22, s * 0.08);
+  ctx.fill();
+  ctx.stroke();
+  const R = azar(tp.id.length * 13);
+  for (let i = 0; i < 14; i++) {
+    ctx.save();
+    ctx.translate((R() - 0.5) * s * 0.44, -s * 0.05 + R() * s * 0.42);
+    particula(ctx, tp.forma, tp.colores[i % tp.colores.length], s * 0.1, R() * TAU);
+    ctx.restore();
+  }
+  ctx.restore();
+}
+
+// ------------------------------------------------------------------ personas
+
+const CUERPOS = {
+  adulto: { piernas: 78, torso: 96, ancho: 70, cabeza: 40 },
+  alto: { piernas: 94, torso: 104, ancho: 68, cabeza: 39 },
+  robusto: { piernas: 72, torso: 98, ancho: 92, cabeza: 42 },
+  nene: { piernas: 50, torso: 68, ancho: 56, cabeza: 40 },
+};
+
+const MANGA_LARGA = new Set(['camisa', 'buzo', 'saco', 'guardapolvo', 'chaqueta', 'heroe', 'bombero', 'chal']);
+
+/** Alto total aproximado de una persona (de los pies a la coronilla), a escala 1. */
+export function altoPersona(look) {
+  const b = CUERPOS[look.body] || CUERPOS.adulto;
+  return b.piernas + b.torso + 8 + b.cabeza * 2;
+}
+
+/**
+ * Persona de frente con los pies en (x, y) y escala s.
+ * o.animo: 'feliz' | 'normal' | 'molesto' | 'enojado' | 'encantado' | 'sorpresa'
+ * o.t: tiempo (para parpadear y respirar). o.camina: fase de caminata. o.pose: 'saluda' | 'anota' | 'valija' | 'llaves'
+ */
+export function persona(ctx, look, x, y, s, o = {}) {
+  const b = CUERPOS[look.body] || CUERPOS.adulto;
+  const t = o.t || 0;
+  const seed = (look.skin || 0) * 7 + (look.hair || '').length * 3 + (look.shirt || '').charCodeAt(2);
+  const resp = o.quieto ? 0 : Math.sin(t * 2.2 + seed) * 1.2;
+  const salto = o.camina !== undefined ? Math.abs(Math.sin(o.camina * 8)) * 4 : 0;
+  const piel = PIELES[look.skin || 0];
+  const pelo = PELOS[look.hairColor] || PELOS.castano;
+  const lw = 3;
+  ctx.save();
+  ctx.translate(x, y - salto * s);
+  ctx.scale(s, s);
+  ctx.lineWidth = lw;
+  ctx.lineJoin = 'round';
+  ctx.lineCap = 'round';
+  ctx.strokeStyle = C.tinta;
+  const cadera = -b.piernas;
+  const hombro = cadera - b.torso + resp;
+  const cuello = hombro - 6;
+  const R = b.cabeza;
+  const cy = cuello - R * 0.92;
+  const w = b.ancho;
+  const fill = (c) => {
+    ctx.fillStyle = c;
+    ctx.fill();
+    ctx.stroke();
+  };
+
+  // capa (atrás de todo)
+  if (look.cape) {
+    ctx.beginPath();
+    ctx.moveTo(-w * 0.5, hombro + 4);
+    ctx.quadraticCurveTo(-w * 0.95, cadera, -w * 0.8, -12);
+    ctx.lineTo(w * 0.8, -12);
+    ctx.quadraticCurveTo(w * 0.95, cadera, w * 0.5, hombro + 4);
+    ctx.closePath();
+    fill(look.cape);
+  }
+  // pelo de atrás
+  peloAtras(ctx, look.hair, pelo, cy, R, t);
+
+  // piernas
+  const fase = o.camina !== undefined ? Math.sin(o.camina * 8) * 7 : 0;
+  const vestido = look.style === 'vestido';
+  for (const sx of [-1, 1]) {
+    const lx = sx * w * 0.2 + (sx < 0 ? fase : -fase) * 0.4;
+    ctx.beginPath();
+    ctx.roundRect(lx - 11, cadera - 4, 22, b.piernas - 6, 9);
+    fill(vestido ? piel : look.pants || '#4b3d33');
+    ctx.beginPath();
+    ctx.ellipse(lx + sx * 3, -7, 16, 8, 0, 0, TAU);
+    fill(look.shoes || C.tinta2);
+  }
+  if (vestido) {
+    ctx.beginPath();
+    ctx.moveTo(-w * 0.45, cadera - 30);
+    ctx.lineTo(-w * 0.68, cadera + b.piernas * 0.45);
+    ctx.quadraticCurveTo(0, cadera + b.piernas * 0.55, w * 0.68, cadera + b.piernas * 0.45);
+    ctx.lineTo(w * 0.45, cadera - 30);
+    ctx.closePath();
+    fill(look.shirt);
+  }
+  if (look.style === 'guardapolvo') {
+    ctx.beginPath();
+    ctx.roundRect(-w * 0.52, hombro + 10, w * 1.04, b.torso + b.piernas * 0.45, 12);
+    fill('#f6f0e6');
+  }
+
+  // brazos (atrás del torso, salvo las poses)
+  const manga = MANGA_LARGA.has(look.style) ? look.shirt : look.style === 'heroe' ? look.shirt : null;
+  const brazo = (sx, ang) => {
+    ctx.save();
+    ctx.translate(sx * (w * 0.5 + 2), hombro + 10);
+    ctx.rotate(ang);
+    const L = b.torso * 0.88;
+    ctx.beginPath();
+    ctx.roundRect(-9, -6, 18, L, 9);
+    fill(manga || piel);
+    if (!manga) {
+      ctx.beginPath();
+      ctx.roundRect(-10, -8, 20, L * 0.34, 9);
+      fill(look.shirt);
+    }
+    ctx.beginPath();
+    ctx.arc(0, L, 9.5, 0, TAU);
+    fill(piel);
+    ctx.restore();
+  };
+  const pose = o.pose;
+  brazo(-1, pose === 'valija' ? 0.05 : 0.12);
+  if (pose !== 'saluda' && pose !== 'anota' && pose !== 'llaves') brazo(1, -0.12);
+
+  // torso
+  ctx.beginPath();
+  ctx.roundRect(-w * 0.5, hombro, w, b.torso + 6, [22, 22, 10, 10]);
+  fill(look.style === 'guardapolvo' ? '#f6f0e6' : look.shirt);
+  ropa(ctx, look, w, hombro, cadera, b);
+
+  // delantal
+  if (look.apron) {
+    ctx.beginPath();
+    ctx.moveTo(-w * 0.3, hombro + 14);
+    ctx.lineTo(w * 0.3, hombro + 14);
+    ctx.lineTo(w * 0.34, hombro + 40);
+    ctx.lineTo(w * 0.44, cadera + 26);
+    ctx.lineTo(-w * 0.44, cadera + 26);
+    ctx.lineTo(-w * 0.34, hombro + 40);
+    ctx.closePath();
+    fill(look.apron);
+    ctx.beginPath();
+    ctx.roundRect(-w * 0.18, cadera - 18, w * 0.36, 20, 5);
+    fill(tono(look.apron, -0.12));
+    // una donita bordada
+    ctx.lineWidth = 2;
+    ctx.beginPath();
+    ctx.arc(0, hombro + 32, 6, 0, TAU);
+    ctx.strokeStyle = tono(look.apron, -0.45);
+    ctx.stroke();
+    ctx.strokeStyle = C.tinta;
+    ctx.lineWidth = lw;
+  }
+
+  // brazos de las poses
+  if (pose === 'saluda') brazo(1, -2.5 + Math.sin(t * 9) * 0.25);
+  if (pose === 'llaves') {
+    brazo(1, -1.2);
+    ctx.save();
+    ctx.translate(w * 0.5 + 2 + Math.cos(-1.2 + Math.PI / 2) * b.torso * 0.88, hombro + 10 + Math.sin(-1.2 + Math.PI / 2) * b.torso * 0.88);
+    ctx.strokeStyle = C.mostaza;
+    ctx.lineWidth = 4;
+    ctx.beginPath();
+    ctx.arc(10, 6, 7, 0, TAU);
+    ctx.moveTo(16, 10);
+    ctx.lineTo(30, 18);
+    ctx.stroke();
+    ctx.restore();
+  }
+  if (pose === 'anota') {
+    ctx.save();
+    ctx.translate(w * 0.12, hombro + b.torso * 0.46);
+    ctx.rotate(-0.12);
+    ctx.beginPath();
+    ctx.roundRect(-18, -24, 36, 44, 4);
+    fill('#fbf5ea');
+    ctx.lineWidth = 2;
+    for (let i = 0; i < 4; i++) {
+      ctx.beginPath();
+      ctx.moveTo(-11, -14 + i * 9);
+      ctx.lineTo(8 - (i % 2) * 6, -14 + i * 9);
+      ctx.stroke();
+    }
+    ctx.lineWidth = lw;
+    ctx.beginPath();
+    ctx.arc(14, 14, 9.5, 0, TAU);
+    fill(piel);
+    ctx.restore();
+  }
+
+  // cuello y bufanda
+  ctx.beginPath();
+  ctx.roundRect(-10, cuello - 6, 20, 16, 5);
+  fill(piel);
+  if (look.scarf) {
+    ctx.beginPath();
+    ctx.roundRect(-w * 0.34, cuello + 2, w * 0.68, 16, 8);
+    fill(look.scarf);
+    ctx.beginPath();
+    ctx.roundRect(w * 0.08, cuello + 10, 15, 42, 6);
+    fill(look.scarf);
+  }
+  if (look.necklace) {
+    ctx.fillStyle = '#fbf5ea';
+    for (let i = -3; i <= 3; i++) {
+      ctx.beginPath();
+      ctx.arc(i * 5.5, cuello + 12 + Math.abs(i) * -1.2 + 3, 3, 0, TAU);
+      ctx.fill();
+    }
+  }
+  if (look.bow) {
+    ctx.beginPath();
+    ctx.moveTo(0, cuello + 9);
+    ctx.lineTo(-12, cuello + 2);
+    ctx.lineTo(-12, cuello + 16);
+    ctx.closePath();
+    ctx.moveTo(0, cuello + 9);
+    ctx.lineTo(12, cuello + 2);
+    ctx.lineTo(12, cuello + 16);
+    ctx.closePath();
+    fill(look.bow);
+  }
+
+  // cabeza
+  for (const sx of [-1, 1]) {
+    ctx.beginPath();
+    ctx.arc(sx * R * 0.96, cy + R * 0.08, R * 0.2, 0, TAU);
+    fill(piel);
+    if (look.earrings) {
+      ctx.beginPath();
+      ctx.arc(sx * R * 0.98, cy + R * 0.36, 3.5, 0, TAU);
+      fill(C.mostaza);
+    }
+  }
+  ctx.beginPath();
+  ctx.ellipse(0, cy, R, R * 1.04, 0, 0, TAU);
+  fill(piel);
+  cara(ctx, look, o.animo || 'feliz', cy, R, t, seed, pelo);
+  peloAdelante(ctx, look.hair, pelo, cy, R);
+  sombrero(ctx, look, cy, R, t);
+  ctx.restore();
+}
+
+/** Detalles de la ropa sobre el torso. */
+function ropa(ctx, look, w, hombro, cadera, b) {
+  const st = look.style || 'remera';
+  const osc = tono(look.shirt, -0.25);
+  ctx.save();
+  ctx.lineWidth = 2.5;
+  if (st === 'remera' || st === 'vestido') {
+    ctx.beginPath();
+    ctx.arc(0, hombro + 2, 13, 0.15 * Math.PI, 0.85 * Math.PI);
+    ctx.stroke();
+  } else if (st === 'camisa' || st === 'guardapolvo' || st === 'chaqueta') {
+    ctx.fillStyle = tono(st === 'camisa' ? look.shirt : '#f6f0e6', 0.2);
+    for (const sx of [-1, 1]) {
+      ctx.beginPath();
+      ctx.moveTo(0, hombro + 2);
+      ctx.lineTo(sx * 16, hombro - 2);
+      ctx.lineTo(sx * 12, hombro + 14);
+      ctx.closePath();
+      ctx.fill();
+      ctx.stroke();
+    }
+    ctx.fillStyle = osc;
+    const cols = st === 'chaqueta' ? [-10, 10] : [0];
+    for (const cx of cols)
+      for (let i = 0; i < 4; i++) {
+        ctx.beginPath();
+        ctx.arc(cx, hombro + 24 + i * 18, 2.6, 0, TAU);
+        ctx.fill();
+      }
+    if (look.tie) {
+      ctx.beginPath();
+      ctx.moveTo(-6, hombro + 8);
+      ctx.lineTo(6, hombro + 8);
+      ctx.lineTo(4, hombro + 52);
+      ctx.lineTo(0, hombro + 60);
+      ctx.lineTo(-4, hombro + 52);
+      ctx.closePath();
+      ctx.fillStyle = look.tie;
+      ctx.fill();
+      ctx.stroke();
+    }
+    if (look.stethoscope) {
+      ctx.strokeStyle = C.tinta2;
+      ctx.lineWidth = 3;
+      ctx.beginPath();
+      ctx.moveTo(-14, hombro + 4);
+      ctx.quadraticCurveTo(-18, hombro + 46, 0, hombro + 50);
+      ctx.quadraticCurveTo(14, hombro + 46, 14, hombro + 4);
+      ctx.stroke();
+      ctx.fillStyle = C.acero;
+      ctx.beginPath();
+      ctx.arc(0, hombro + 54, 6, 0, TAU);
+      ctx.fill();
+      ctx.stroke();
+    }
+  } else if (st === 'buzo') {
+    ctx.beginPath();
+    ctx.roundRect(-w * 0.3, cadera - 34, w * 0.6, 24, 8);
+    ctx.fillStyle = osc;
+    ctx.fill();
+    ctx.stroke();
+    ctx.beginPath();
+    ctx.moveTo(-6, hombro + 6);
+    ctx.lineTo(-6, hombro + 30);
+    ctx.moveTo(6, hombro + 6);
+    ctx.lineTo(6, hombro + 30);
+    ctx.stroke();
+  } else if (st === 'saco') {
+    ctx.fillStyle = '#f4ead8';
+    ctx.beginPath();
+    ctx.moveTo(-14, hombro);
+    ctx.lineTo(14, hombro);
+    ctx.lineTo(0, hombro + 40);
+    ctx.closePath();
+    ctx.fill();
+    ctx.stroke();
+    ctx.fillStyle = osc;
+    for (const sx of [-1, 1]) {
+      ctx.beginPath();
+      ctx.moveTo(sx * 14, hombro);
+      ctx.lineTo(sx * 4, hombro + 44);
+      ctx.lineTo(sx * 22, hombro + 18);
+      ctx.closePath();
+      ctx.fill();
+      ctx.stroke();
+    }
+  } else if (st === 'chal') {
+    ctx.fillStyle = tono(look.shirt, 0.25);
+    ctx.beginPath();
+    ctx.moveTo(-w * 0.55, hombro + 8);
+    ctx.quadraticCurveTo(0, hombro + 12, w * 0.55, hombro + 8);
+    ctx.lineTo(0, hombro + 64);
+    ctx.closePath();
+    ctx.fill();
+    ctx.stroke();
+  } else if (st === 'bombero') {
+    ctx.fillStyle = C.mostaza2;
+    for (const yy of [hombro + 40, hombro + 70]) {
+      ctx.fillRect(-w * 0.5 + 2, yy, w - 4, 8);
+    }
+  } else if (st === 'heroe') {
+    ctx.beginPath();
+    ctx.arc(0, hombro + 34, 15, 0, TAU);
+    ctx.fillStyle = C.mostaza;
+    ctx.fill();
+    ctx.stroke();
+    ctx.beginPath();
+    ctx.arc(0, hombro + 34, 5, 0, TAU);
+    ctx.fillStyle = look.shirt;
+    ctx.fill();
+    ctx.stroke();
+    ctx.fillStyle = C.mostaza;
+    ctx.fillRect(-w * 0.5 + 2, cadera - 12, w - 4, 9);
+  }
+  ctx.restore();
+}
+
+/** Ojos, cejas, nariz, boca, barba y anteojos. */
+function cara(ctx, look, animo, cy, R, t, seed, pelo) {
+  const ey = cy + R * 0.02;
+  const ex = R * 0.38;
+  const parpadeo = (t + seed * 0.37) % 4.2 < 0.13;
+  const cerrados = animo === 'encantado' || parpadeo;
+  ctx.save();
+  ctx.lineWidth = 3;
+  // mejillas
+  ctx.fillStyle = 'rgba(200,85,61,.22)';
+  for (const sx of [-1, 1]) {
+    ctx.beginPath();
+    ctx.ellipse(sx * R * 0.55, cy + R * 0.38, R * 0.17, R * 0.1, 0, 0, TAU);
+    ctx.fill();
+  }
+  if (look.freckles) {
+    ctx.fillStyle = alfa('#8d5a3b', 0.55);
+    for (const sx of [-1, 1])
+      for (const [dx, dy] of [[0.45, 0.24], [0.58, 0.3], [0.5, 0.36], [0.64, 0.22]]) {
+        ctx.beginPath();
+        ctx.arc(sx * dx * R, cy + dy * R, 1.6, 0, TAU);
+        ctx.fill();
+      }
+  }
+  // ojos
+  for (const sx of [-1, 1]) {
+    const x = sx * ex;
+    if (cerrados) {
+      ctx.beginPath();
+      if (animo === 'encantado') ctx.arc(x, ey + 3, R * 0.13, Math.PI * 1.1, Math.PI * 1.9);
+      else {
+        ctx.moveTo(x - R * 0.12, ey);
+        ctx.lineTo(x + R * 0.12, ey);
+      }
+      ctx.stroke();
+    } else if (look.eyes === 'grande') {
+      ctx.fillStyle = '#fffaf2';
+      ctx.beginPath();
+      ctx.ellipse(x, ey, R * 0.15, R * 0.18, 0, 0, TAU);
+      ctx.fill();
+      ctx.lineWidth = 2;
+      ctx.stroke();
+      ctx.fillStyle = C.tinta;
+      ctx.beginPath();
+      ctx.arc(x + sx * 1, ey + 2, R * 0.09, 0, TAU);
+      ctx.fill();
+      ctx.fillStyle = '#fffaf2';
+      ctx.beginPath();
+      ctx.arc(x - 2, ey - 1, R * 0.035, 0, TAU);
+      ctx.fill();
+      ctx.lineWidth = 3;
+    } else {
+      ctx.fillStyle = C.tinta;
+      ctx.beginPath();
+      ctx.ellipse(x, ey, R * 0.08, R * 0.11, 0, 0, TAU);
+      ctx.fill();
+      ctx.fillStyle = '#fffaf2';
+      ctx.beginPath();
+      ctx.arc(x - 1.5, ey - 3, R * 0.03, 0, TAU);
+      ctx.fill();
+      if (look.eyes === 'pestanas') {
+        ctx.lineWidth = 2;
+        ctx.beginPath();
+        ctx.moveTo(x + sx * R * 0.07, ey - R * 0.08);
+        ctx.lineTo(x + sx * R * 0.15, ey - R * 0.14);
+        ctx.stroke();
+        ctx.lineWidth = 3;
+      }
+    }
+    // cejas
+    const enojo = animo === 'enojado' ? 0.35 : animo === 'molesto' ? 0.15 : animo === 'sorpresa' ? -0.2 : 0;
+    ctx.strokeStyle = tono(pelo, -0.3);
+    ctx.lineWidth = 3.5;
+    ctx.beginPath();
+    // con enojo, la punta de adentro de cada ceja baja; con sorpresa, sube
+    const by = ey - R * 0.3 - (animo === 'sorpresa' ? 4 : 0);
+    const e = enojo * R * 0.24;
+    ctx.moveTo(x + sx * R * 0.14, by - e * 0.4);
+    ctx.lineTo(x - sx * R * 0.14, by + e);
+    ctx.stroke();
+    ctx.strokeStyle = C.tinta;
+    ctx.lineWidth = 3;
+  }
+  // nariz
+  ctx.beginPath();
+  ctx.arc(0, cy + R * 0.22, R * 0.08, 0.1 * Math.PI, 0.9 * Math.PI);
+  ctx.stroke();
+  // boca
+  const my = cy + R * 0.5;
+  ctx.beginPath();
+  if (animo === 'feliz') ctx.arc(0, my - R * 0.1, R * 0.22, 0.2 * Math.PI, 0.8 * Math.PI);
+  else if (animo === 'encantado') {
+    ctx.moveTo(-R * 0.26, my - R * 0.06);
+    ctx.quadraticCurveTo(0, my + R * 0.34, R * 0.26, my - R * 0.06);
+    ctx.closePath();
+    ctx.fillStyle = '#7a3a2c';
+    ctx.fill();
+  } else if (animo === 'molesto') {
+    ctx.moveTo(-R * 0.16, my + 2);
+    ctx.quadraticCurveTo(0, my - R * 0.06, R * 0.16, my + 2);
+  } else if (animo === 'enojado') ctx.arc(0, my + R * 0.16, R * 0.2, 1.2 * Math.PI, 1.8 * Math.PI);
+  else if (animo === 'sorpresa') {
+    ctx.ellipse(0, my, R * 0.09, R * 0.12, 0, 0, TAU);
+    ctx.fillStyle = '#7a3a2c';
+    ctx.fill();
+  } else {
+    ctx.moveTo(-R * 0.14, my);
+    ctx.quadraticCurveTo(0, my + R * 0.06, R * 0.14, my);
+  }
+  ctx.stroke();
+  // barba y bigote
+  if (look.beard === 'barba' || look.beard === 'candado') {
+    ctx.beginPath();
+    if (look.beard === 'barba') {
+      ctx.moveTo(-R * 0.98, cy + R * 0.05);
+      ctx.quadraticCurveTo(-R * 0.9, cy + R * 1.1, 0, cy + R * 1.18);
+      ctx.quadraticCurveTo(R * 0.9, cy + R * 1.1, R * 0.98, cy + R * 0.05);
+      ctx.quadraticCurveTo(R * 0.6, cy + R * 0.62, 0, cy + R * 0.66);
+      ctx.quadraticCurveTo(-R * 0.6, cy + R * 0.62, -R * 0.98, cy + R * 0.05);
+    } else {
+      ctx.moveTo(-R * 0.3, cy + R * 0.66);
+      ctx.quadraticCurveTo(0, cy + R * 1.08, R * 0.3, cy + R * 0.66);
+      ctx.quadraticCurveTo(0, cy + R * 0.8, -R * 0.3, cy + R * 0.66);
+    }
+    ctx.fillStyle = pelo;
+    ctx.fill();
+    ctx.stroke();
+  }
+  if (look.beard === 'bigote' || look.beard === 'barba' || look.beard === 'candado') {
+    ctx.beginPath();
+    ctx.moveTo(0, cy + R * 0.33);
+    ctx.quadraticCurveTo(-R * 0.3, cy + R * 0.28, -R * 0.36, cy + R * 0.46);
+    ctx.quadraticCurveTo(-R * 0.16, cy + R * 0.42, 0, cy + R * 0.38);
+    ctx.quadraticCurveTo(R * 0.16, cy + R * 0.42, R * 0.36, cy + R * 0.46);
+    ctx.quadraticCurveTo(R * 0.3, cy + R * 0.28, 0, cy + R * 0.33);
+    ctx.fillStyle = pelo;
+    ctx.fill();
+    ctx.stroke();
+  }
+  // antifaz
+  if (look.mask) {
+    ctx.beginPath();
+    ctx.roundRect(-R * 0.72, ey - R * 0.2, R * 1.44, R * 0.38, R * 0.18);
+    ctx.fillStyle = look.mask;
+    ctx.fill();
+    ctx.stroke();
+    ctx.fillStyle = '#fffaf2';
+    for (const sx of [-1, 1]) {
+      ctx.beginPath();
+      ctx.ellipse(sx * ex, ey, R * 0.12, R * 0.09, 0, 0, TAU);
+      ctx.fill();
+      ctx.fillStyle = C.tinta;
+      ctx.beginPath();
+      ctx.arc(sx * ex, ey + 1, R * 0.05, 0, TAU);
+      ctx.fill();
+      ctx.fillStyle = '#fffaf2';
+    }
+  }
+  // anteojos
+  if (look.glasses) {
+    ctx.lineWidth = 3;
+    ctx.strokeStyle = C.tinta;
+    ctx.fillStyle = 'rgba(255,250,242,.18)';
+    for (const sx of [-1, 1]) {
+      ctx.beginPath();
+      if (look.glasses === 'cuadrados') ctx.roundRect(sx * ex - R * 0.22, ey - R * 0.17, R * 0.44, R * 0.34, 4);
+      else ctx.arc(sx * ex, ey, R * 0.21, 0, TAU);
+      ctx.fill();
+      ctx.stroke();
+    }
+    ctx.beginPath();
+    ctx.moveTo(-ex + R * 0.2, ey - 2);
+    ctx.quadraticCurveTo(0, ey - 7, ex - R * 0.2, ey - 2);
+    ctx.stroke();
+  }
+  ctx.restore();
+}
+
+/** La parte del pelo que va detrás de la cabeza. */
+function peloAtras(ctx, estilo, pelo, cy, R, t) {
+  ctx.fillStyle = pelo;
+  ctx.beginPath();
+  if (estilo === 'largo') {
+    ctx.roundRect(-R * 1.08, cy - R * 0.7, R * 2.16, R * 2.15, [R, R, R * 0.4, R * 0.4]);
+  } else if (estilo === 'afro') {
+    ctx.arc(0, cy - R * 0.15, R * 1.5, 0, TAU);
+  } else if (estilo === 'colita') {
+    const sw = Math.sin(t * 3) * 0.08;
+    ctx.save();
+    ctx.translate(R * 0.75, cy - R * 0.55);
+    ctx.rotate(0.6 + sw);
+    ctx.ellipse(R * 0.25, R * 0.55, R * 0.28, R * 0.7, 0, 0, TAU);
+    ctx.restore();
+  } else if (estilo === 'trenzas') {
+    for (const sx of [-1, 1])
+      for (let i = 0; i < 4; i++) {
+        ctx.moveTo(sx * R * 0.95 + R * 0.17, cy + R * 0.25 + i * R * 0.28);
+        ctx.arc(sx * R * 0.95, cy + R * 0.25 + i * R * 0.28, R * 0.17, 0, TAU);
+      }
+  } else if (estilo === 'rulos') {
+    for (let i = 0; i < 9; i++) {
+      const a = Math.PI * (0.05 + i * 0.112);
+      const x = Math.cos(a + Math.PI) * R * 1.02;
+      const y = cy + Math.sin(a + Math.PI) * R * 0.95 + R * 0.25;
+      ctx.moveTo(x + R * 0.3, y);
+      ctx.arc(x, y, R * 0.3, 0, TAU);
+    }
+  } else return;
+  ctx.fill();
+  ctx.stroke();
+}
+
+/** La parte del pelo que va sobre la cabeza (flequillo, jopo, rodete…). */
+function peloAdelante(ctx, estilo, pelo, cy, R) {
+  if (estilo === 'pelado') {
+    ctx.fillStyle = pelo;
+    for (const sx of [-1, 1]) {
+      ctx.beginPath();
+      ctx.ellipse(sx * R * 0.86, cy - R * 0.1, R * 0.16, R * 0.32, 0, 0, TAU);
+      ctx.fill();
+      ctx.stroke();
+    }
+    ctx.fillStyle = 'rgba(255,250,242,.35)';
+    ctx.beginPath();
+    ctx.ellipse(-R * 0.3, cy - R * 0.72, R * 0.22, R * 0.08, -0.4, 0, TAU);
+    ctx.fill();
+    return;
+  }
+  ctx.fillStyle = pelo;
+  ctx.beginPath();
+  if (estilo === 'rapado') {
+    ctx.arc(0, cy, R * 1.0, Math.PI * 1.08, Math.PI * 1.92);
+    ctx.quadraticCurveTo(0, cy - R * 0.62, -R * 0.94, cy - R * 0.25);
+    ctx.globalAlpha = 0.75;
+    ctx.fill();
+    ctx.globalAlpha = 1;
+    ctx.stroke();
+    return;
+  }
+  // gorro de pelo (base de casi todos los peinados)
+  ctx.moveTo(-R * 1.04, cy + R * 0.12);
+  ctx.quadraticCurveTo(-R * 1.12, cy - R * 1.12, 0, cy - R * 1.12);
+  ctx.quadraticCurveTo(R * 1.12, cy - R * 1.12, R * 1.04, cy + R * 0.12);
+  if (estilo === 'flequillo') {
+    ctx.lineTo(R * 0.8, cy - R * 0.25);
+    for (let i = 0; i < 6; i++) ctx.lineTo(R * (0.62 - i * 0.29), cy - R * (i % 2 ? 0.22 : 0.42));
+    ctx.lineTo(-R * 0.82, cy - R * 0.3);
+  } else if (estilo === 'rulos' || estilo === 'afro') {
+    for (let i = 0; i < 6; i++) {
+      const x = R * (0.75 - i * 0.3);
+      ctx.quadraticCurveTo(x + R * 0.12, cy - R * 0.25, x - R * 0.15, cy - R * 0.5);
+    }
+  } else {
+    ctx.quadraticCurveTo(R * 0.7, cy - R * 0.62, R * 0.1, cy - R * 0.58);
+    ctx.quadraticCurveTo(-R * 0.6, cy - R * 0.58, -R * 0.86, cy - R * 0.25);
+  }
+  ctx.closePath();
+  ctx.fill();
+  ctx.stroke();
+  if (estilo === 'jopo') {
+    ctx.beginPath();
+    ctx.ellipse(R * 0.1, cy - R * 1.05, R * 0.62, R * 0.32, -0.15, 0, TAU);
+    ctx.fill();
+    ctx.stroke();
+  }
+  if (estilo === 'rodete') {
+    ctx.beginPath();
+    ctx.arc(0, cy - R * 1.2, R * 0.36, 0, TAU);
+    ctx.fill();
+    ctx.stroke();
+  }
+  if (estilo === 'colita') {
+    ctx.beginPath();
+    ctx.roundRect(R * 0.62, cy - R * 0.78, R * 0.22, R * 0.2, 4);
+    ctx.fillStyle = C.terracota;
+    ctx.fill();
+    ctx.stroke();
+  }
+}
+
+/** Gorros y cosas en la cabeza. */
+function sombrero(ctx, look, cy, R, t) {
+  const h = look.hat;
+  const col = look.hatColor || C.terracota;
+  if (look.headband) {
+    ctx.beginPath();
+    ctx.roundRect(-R * 1.02, cy - R * 0.62, R * 2.04, R * 0.22, 6);
+    ctx.fillStyle = look.headband;
+    ctx.fill();
+    ctx.stroke();
+  }
+  if (look.flower) {
+    ctx.save();
+    ctx.translate(R * 0.72, cy - R * 0.72);
+    ctx.fillStyle = look.flower;
+    for (let i = 0; i < 5; i++) {
+      ctx.beginPath();
+      ctx.arc(Math.cos((i / 5) * TAU) * 7, Math.sin((i / 5) * TAU) * 7, 6, 0, TAU);
+      ctx.fill();
+      ctx.stroke();
+    }
+    ctx.fillStyle = C.mostaza;
+    ctx.beginPath();
+    ctx.arc(0, 0, 5, 0, TAU);
+    ctx.fill();
+    ctx.stroke();
+    ctx.restore();
+  }
+  if (!h) return;
+  ctx.save();
+  if (h === 'gorra' || h === 'gorra-atras' || h === 'helice') {
+    ctx.beginPath();
+    ctx.moveTo(-R * 1.0, cy - R * 0.32);
+    ctx.quadraticCurveTo(-R * 1.0, cy - R * 1.22, 0, cy - R * 1.22);
+    ctx.quadraticCurveTo(R * 1.0, cy - R * 1.22, R * 1.0, cy - R * 0.32);
+    ctx.closePath();
+    ctx.fillStyle = col;
+    ctx.fill();
+    ctx.stroke();
+    if (h === 'helice') {
+      ctx.fillStyle = C.mostaza;
+      ctx.beginPath();
+      ctx.moveTo(0, cy - R * 1.22);
+      ctx.lineTo(0, cy - R * 0.32);
+      ctx.lineTo(R * 0.5, cy - R * 0.4);
+      ctx.quadraticCurveTo(R * 0.4, cy - R * 1.05, 0, cy - R * 1.22);
+      ctx.fill();
+      ctx.stroke();
+      const a = t * 12;
+      ctx.fillStyle = C.terracota;
+      ctx.beginPath();
+      ctx.ellipse(0, cy - R * 1.32, R * 0.62 * Math.abs(Math.cos(a)), R * 0.1, 0, 0, TAU);
+      ctx.fill();
+      ctx.stroke();
+      ctx.beginPath();
+      ctx.moveTo(0, cy - R * 1.22);
+      ctx.lineTo(0, cy - R * 1.34);
+      ctx.stroke();
+    } else if (h === 'gorra') {
+      ctx.beginPath();
+      ctx.ellipse(0, cy - R * 0.32, R * 1.12, R * 0.2, 0, 0, Math.PI);
+      ctx.fillStyle = tono(col, -0.15);
+      ctx.fill();
+      ctx.stroke();
+    } else {
+      ctx.beginPath();
+      ctx.roundRect(-R * 0.25, cy - R * 0.45, R * 0.5, R * 0.16, 4);
+      ctx.fillStyle = tono(col, -0.15);
+      ctx.fill();
+      ctx.stroke();
+    }
+  } else if (h === 'chef') {
+    ctx.fillStyle = '#fbf5ea';
+    ctx.beginPath();
+    ctx.roundRect(-R * 0.75, cy - R * 1.25, R * 1.5, R * 0.62, 6);
+    ctx.fill();
+    ctx.stroke();
+    ctx.beginPath();
+    for (const [x, y, r] of [[-0.5, -1.55, 0.42], [0, -1.75, 0.5], [0.5, -1.55, 0.42]]) {
+      ctx.moveTo(x * R + r * R, cy + y * R);
+      ctx.arc(x * R, cy + y * R, r * R, 0, TAU);
+    }
+    ctx.fill();
+    ctx.stroke();
+    ctx.beginPath();
+    ctx.roundRect(-R * 0.75, cy - R * 1.25, R * 1.5, R * 0.62, 6);
+    ctx.fill();
+    ctx.beginPath();
+    ctx.moveTo(-R * 0.75, cy - R * 0.85);
+    ctx.lineTo(R * 0.75, cy - R * 0.85);
+    ctx.stroke();
+  } else if (h === 'boina') {
+    ctx.beginPath();
+    ctx.ellipse(-R * 0.15, cy - R * 0.92, R * 1.05, R * 0.38, -0.12, 0, TAU);
+    ctx.fillStyle = col;
+    ctx.fill();
+    ctx.stroke();
+    ctx.beginPath();
+    ctx.moveTo(-R * 0.1, cy - R * 1.3);
+    ctx.lineTo(-R * 0.05, cy - R * 1.46);
+    ctx.stroke();
+  } else if (h === 'sombrero') {
+    ctx.beginPath();
+    ctx.ellipse(0, cy - R * 0.72, R * 1.55, R * 0.3, 0, 0, TAU);
+    ctx.fillStyle = col;
+    ctx.fill();
+    ctx.stroke();
+    ctx.beginPath();
+    ctx.roundRect(-R * 0.72, cy - R * 1.42, R * 1.44, R * 0.74, [R * 0.5, R * 0.5, 4, 4]);
+    ctx.fill();
+    ctx.stroke();
+    ctx.fillStyle = C.terracota;
+    ctx.fillRect(-R * 0.72, cy - R * 0.92, R * 1.44, R * 0.16);
+    ctx.strokeRect(-R * 0.72, cy - R * 0.92, R * 1.44, R * 0.16);
+  } else if (h === 'panuelo') {
+    ctx.beginPath();
+    ctx.moveTo(-R * 1.05, cy - R * 0.38);
+    ctx.quadraticCurveTo(0, cy - R * 1.45, R * 1.05, cy - R * 0.38);
+    ctx.quadraticCurveTo(0, cy - R * 0.62, -R * 1.05, cy - R * 0.38);
+    ctx.fillStyle = col;
+    ctx.fill();
+    ctx.stroke();
+    ctx.fillStyle = 'rgba(255,250,242,.7)';
+    for (const [x, y] of [[-0.5, -0.82], [0, -1.0], [0.5, -0.82], [-0.25, -0.62], [0.25, -0.62]]) {
+      ctx.beginPath();
+      ctx.arc(x * R, cy + y * R, 3, 0, TAU);
+      ctx.fill();
+    }
+  }
+  ctx.restore();
+}
+
+/** Retrato (cabeza y hombros) dentro de un círculo. */
+export function retrato(ctx, look, x, y, rad, o = {}) {
+  ctx.save();
+  ctx.beginPath();
+  ctx.arc(x, y, rad, 0, TAU);
+  ctx.fillStyle = o.fondo || C.crema;
+  ctx.fill();
+  ctx.clip();
+  const b = CUERPOS[look.body] || CUERPOS.adulto;
+  // la cara ocupa más o menos la mitad del círculo y queda un poco arriba del centro
+  const s = (rad * 0.52) / b.cabeza;
+  const pies = y + rad * 0.08 + (b.piernas + b.torso + 6 + b.cabeza * 0.92) * s;
+  persona(ctx, look, x, pies, s, { animo: o.animo || 'feliz', t: o.t || 0, quieto: true });
+  ctx.restore();
+  ctx.lineWidth = Math.max(1.5, rad * 0.06);
+  ctx.strokeStyle = o.borde || C.tinta;
+  ctx.beginPath();
+  ctx.arc(x, y, rad, 0, TAU);
+  ctx.stroke();
+}
