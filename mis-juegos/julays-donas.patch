+  } else if (id === 'maquina-chicles') {
+    ctx.fillStyle = C.terracota;
+    ctx.beginPath();
+    ctx.roundRect(x - 22, y - 78, 44, 78, 8);
+    ctx.fill();
+    ctx.stroke();
+    ctx.fillStyle = 'rgba(207,224,230,.9)';
