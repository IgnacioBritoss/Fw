+/**
+ * Julay's Donas — todo el contenido del juego: ingredientes (y el día en que aparecen), clientes,
+ * clientes exigentes, decoraciones del local, logros, la historia y los textos en español e inglés.
+ */
+
+// ------------------------------------------------------------------ colores (paleta tierra)
+
+export const C = {
+  tinta: '#3b2a20',
+  tinta2: '#6b5545',
+  crema: '#f4ead8',
+  papel: '#fbf5ea',
+  terracota: '#c8553d',
+  terracota2: '#a5432f',
+  mostaza: '#d4a017',
+  mostaza2: '#e8c35a',
+  oliva: '#6a994e',
+  oliva2: '#8fb46e',
+  petroleo: '#2f6690',
+  petroleo2: '#5a8db8',
+  ciruela: '#7b4b94',
+  ciruela2: '#9a72ad',
+  rosa: '#c47a8a',
+  rosa2: '#e0a7b3',
+  madera: '#9c6b45',
+  madera2: '#7a5034',
+  madera3: '#b88a5e',
+  pared: '#efe2cb',
+  acero: '#a39d95',
+  acero2: '#7d7770',
+  aceite: '#d9a441',
+  aceite2: '#c08a2c',
+};
+
+export const PIELES = ['#f6d7c3', '#eec19f', '#d9a27c', '#b97c55', '#8d5a3b', '#5f3b27'];
+
+export const PELOS = {
+  negro: '#2b211c',
+  'castano-oscuro': '#4a3021',
+  castano: '#6e4630',
+  'castano-claro': '#94653f',
+  rubio: '#c9a052',
+  'rubio-claro': '#e3c98a',
