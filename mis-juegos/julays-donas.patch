+    d.etapa = 'tirada';
+    this.donas = this.donas.filter((x) => x !== d);
+    this.emit('tirar');
+  }
+
+  crudas() {
+    return this.donas.filter((d) => d.etapa === 'cruda');
+  }
+
+  listas() {
+    return this.donas.filter((d) => d.etapa === 'lista');
+  }
+
+  meterAlAceite(d, slot = this.freidora.indexOf(null)) {
+    if (!d || d.etapa !== 'cruda' || slot < 0 || this.freidora[slot]) return false;
+    this.freidora[slot] = d;
+    d.etapa = 'aceite';
+    d.lado = 0;
+    d.avisado = false;
+    this.emit('aceite');
+    return true;
+  }
+
+  /** Tocar una dona en el aceite: la primera vez se da vuelta; la segunda, sale. */
+  tocarEnAceite(slot) {
+    const d = this.freidora[slot];
+    if (!d) return null;
+    if (d.lado === 0) {
+      d.lado = 1;
+      d.avisado = false;
+      d.giro = 1;
+      this.emit('vuelta');
+      return 'vuelta';
+    }
+    this.freidora[slot] = null;
+    d.etapa = 'lista';
+    this.emit('sacar', { dona: d });
+    return 'sacar';
+  }
+
+  // ---------------------------------------------------------------- tickets
+
+  /** Qué le falta a un ticket: 'masa' | 'fritura' | 'decorado'. */
+  estadoTicket(tk) {
+    if (tk.hechas.some((h) => !h)) return 'masa';
+    if (tk.hechas.some((h) => h.etapa !== 'lista')) return 'fritura';
+    return 'decorado';
+  }
+
+  pendientes() {
+    return this.tickets.filter((t) => !t.entregado);
+  }
+
+  /** Entregar el pedido: calcula el puntaje y la propina. Devuelve el resultado. */
+  entregar(tk) {
+    if (tk.entregado || this.estadoTicket(tk) !== 'decorado') return null;
+    tk.entregado = true;
+    const a = tk.actor;
+    const espera = this.t - a.t0;
+    const ex = tk.exigente;
+    const notas = {
+      espera: notaEspera(espera, tk.pedido.donas.length, this.pacienciaDe(a.def), !!ex),
+      masa: notaMasa(tk.pedido, tk.hechas),
+      fritura: notaFritura(tk.pedido, tk.hechas),
+      decorado: notaDecorado(tk.pedido, tk.hechas),
+    };
+    const fin = notaFinal(notas, ex, this.n);
+    const res = {
+      ticket: tk,
+      actor: a,
+      crudas: notas,
+      notas: fin.notas,
+      total: fin.total,
+      propina: propina(fin.total, tk.pedido.donas.length, !!ex, this.bonus.propinas),
+      espera,
+    };
+    this.resultados.push(res);
+    for (const d of tk.hechas) this.donas = this.donas.filter((x) => x !== d);
+    a.estado = 'retira';
+    a.tx = LUGARES.retiro.x;
+    a.ty = LUGARES.retiro.y;
+    a.asiento = -1;
+    this.emit('entrega', { resultado: res });
+    return res;
+  }
+
+  /** Después del cartel de puntaje, el cliente se va. */
+  despedir(a) {
+    a.estado = 'sale';
+    a.tx = LUGARES.puerta.x;
+    a.ty = LUGARES.puerta.y;
+  }
+
+  get terminado() {
+    return this.exigenteLlego && this.llegaron >= this.lista.length && this.actores.every((a) => a.estado === 'fuera' || a.estado === 'sale') && this.resultados.length >= this.total;
+  }
+
+  // ---------------------------------------------------------------- tiempo
+
+  update(dt) {
+    this.t += dt;
+    // llegadas: si hay lugar en la fila y llegó la hora
+    if (this.llegaron < this.lista.length) {
+      if (this.t >= this.proxima && this.fila.length < 4) {
+        this.llegar(this.lista[this.llegaron++]);
+        this.proxima = this.t + this.espacio();
+      }
+    } else if (!this.exigenteLlego) {
+      // el exigente es el último: cuando ya pidieron todos y no hay demasiado pendiente
+      const sinPedir = this.fila.length;
+      if (!sinPedir && this.pendientes().length <= 2 && this.t >= this.proxima) {
+        this.exigenteLlego = true;
+        this.llegar(this.exigenteDef, true);
+      }
+    }
+    // clientes
+    for (const a of this.actores) {
+      if (a.estado === 'fuera') continue;
+      const dx = a.tx - a.x;
+      const dy = a.ty - a.y;
+      const d = Math.hypot(dx, dy);
+      const vel = 240;
+      if (d > 1) {
+        const k = Math.min(1, (vel * dt) / d);
+        a.x += dx * k;
+        a.y += dy * k;
+        a.fase += dt;
+        a.camina = true;
+      } else {
+        a.x = a.tx;
+        a.y = a.ty;
+        a.camina = false;
+      }
+      if (a.estado === 'pidiendo') {
+        a.tPedido -= dt;
+        if (a.tPedido <= 0) {
+          a.estado = 'esperando';
+          this.tickets.push(a.ticket);
+          this.fila.shift();
+          this.reubicarFila();
+          a.asiento = this.asientoLibre();
+          const p = a.asiento >= 0 ? LUGARES.asientos[a.asiento] : { x: 560 + (a.id % 3) * 30, y: 520 };
+          a.tx = p.x;
+          a.ty = p.y;
+          this.emit('ticket', { ticket: a.ticket });
+        }
+      }
+      if (a.estado === 'sale' && d <= 1) a.estado = 'fuera';
+      // humor según cuánto espera
+      if (a.estado === 'fila' || a.estado === 'esperando') {
+        const tol = tolerancia(a.ticket ? a.ticket.pedido.donas.length : 1, this.pacienciaDe(a.def));
+        const e = this.t - a.t0;
+        a.animo = e < tol ? 'feliz' : e < tol + 55 ? 'normal' : e < tol + 110 ? 'molesto' : 'enojado';
+      }
+    }
+    // freidora: el lado de abajo se sigue cocinando
+    this.freidora.forEach((d, i) => {
+      if (!d) return;
+      d.coc[d.lado] += COCCION * dt;
+      if (d.giro) d.giro = Math.max(0, d.giro - dt * 3);
+      if (!d.avisado && d.coc[d.lado] >= PUNTO[0]) {
+        d.avisado = true;
+        this.emit('punto', { slot: i, lado: d.lado });
+      }
+      if (!d.quemaAviso && d.coc[d.lado] >= 1.45) {
+        d.quemaAviso = true;
+        this.emit('quema', { slot: i });
+      }
+    });
+  }
+
+  /** ¿Hay que mirar la freidora? (algo en su punto o pasándose) */
+  freidoraAvisa() {
+    return this.freidora.some((d) => d && d.coc[d.lado] >= PUNTO[0]);
+  }
+}
diff --git a/public/games/julays-donas/dibujo.js b/public/games/julays-donas/dibujo.js
new file mode 100644
index 0000000..4af3ed3
--- /dev/null
+++ b/public/games/julays-donas/dibujo.js
@@ -0,0 +1,211 @@
+/**
+ * Piezas de interfaz dibujadas en el canvas: botones, burbujas de diálogo, monedas, barras y textos.
+ */
+import { C } from './data.js';
+import { TAU, tono, alfa } from './art.js';
+
+export const F = (peso, px) => `${peso} ${px}px Fredoka, "Trebuchet MS", sans-serif`;
+
+export const dentroRect = (p, r) => p.x >= r.x && p.x <= r.x + r.w && p.y >= r.y && p.y <= r.y + r.h;
+
+/** Botón redondeado. estilo: 'primario' | 'secundario' | 'peligro' | 'apagado'. */
+export function boton(ctx, r, texto, o = {}) {
+  const estilo = o.estilo || 'primario';
+  const col = { primario: C.terracota, secundario: C.crema, peligro: '#b9653f', apagado: '#d8cfc2', verde: C.oliva }[estilo];
+  const presionado = o.presionado ? 3 : 0;
+  ctx.save();
+  ctx.fillStyle = tono(col, -0.3);
+  ctx.beginPath();
+  ctx.roundRect(r.x, r.y + 5, r.w, r.h, o.radio ?? 14);
+  ctx.fill();
+  ctx.fillStyle = col;
+  ctx.beginPath();
+  ctx.roundRect(r.x, r.y + presionado, r.w, r.h, o.radio ?? 14);
+  ctx.fill();
+  ctx.lineWidth = 3;
+  ctx.strokeStyle = C.tinta;
+  ctx.beginPath();
+  ctx.roundRect(r.x, r.y + presionado, r.w, r.h + 5 - presionado, o.radio ?? 14);
+  ctx.stroke();
+  ctx.fillStyle = estilo === 'secundario' || estilo === 'apagado' ? C.tinta : C.crema;
+  if (estilo === 'apagado') ctx.globalAlpha = 0.6;
+  ctx.font = F(700, o.tam || 22);
+  ctx.textAlign = 'center';
+  ctx.textBaseline = 'middle';
+  ctx.fillText(texto, r.x + r.w / 2 + (o.icono ? 12 : 0), r.y + r.h / 2 + presionado + 1, r.w - 16);
+  ctx.restore();
+}
+
+/** Texto en varias líneas dentro de un ancho. Devuelve el alto usado. */
+export function parrafo(ctx, texto, x, y, ancho, alto, o = {}) {
+  ctx.save();
+  ctx.font = o.font || F(500, 18);
+  ctx.fillStyle = o.color || C.tinta;
+  ctx.textAlign = o.align || 'left';
+  ctx.textBaseline = 'top';
+  const lineas = [];
+  for (const par of String(texto).split('\n')) {
+    let l = '';
+    for (const w of par.split(' ')) {
+      const prueba = l ? l + ' ' + w : w;
+      if (ctx.measureText(prueba).width > ancho && l) {
+        lineas.push(l);
+        l = w;
+      } else l = prueba;
+    }
+    lineas.push(l);
+  }
+  lineas.forEach((l, i) => ctx.fillText(l, x, y + i * alto));
+  ctx.restore();
+  return lineas.length * alto;
+}
+
+/** Burbuja de diálogo con la colita apuntando a (px, py). */
+export function burbuja(ctx, x, y, w, h, px, py, o = {}) {
+  ctx.save();
+  ctx.fillStyle = o.fondo || C.papel;
+  ctx.strokeStyle = C.tinta;
+  ctx.lineWidth = 3;
+  ctx.beginPath();
+  ctx.roundRect(x, y, w, h, 16);
+  const bx = Math.max(x + 22, Math.min(x + w - 22, px));
+  const abajo = py > y + h;
+  const by = abajo ? y + h : y;
+  ctx.moveTo(bx - 12, by);
+  ctx.lineTo(px, py);
+  ctx.lineTo(bx + 12, by);
+  ctx.fill();
+  ctx.stroke();
+  // tapar la línea entre la colita y la burbuja
+  ctx.fillRect(bx - 10, abajo ? by - 3 : by, 20, 4);
+  ctx.restore();
+}
+
+export function moneda(ctx, x, y, r) {
+  ctx.save();
+  ctx.fillStyle = C.mostaza;
+  ctx.strokeStyle = C.tinta;
+  ctx.lineWidth = Math.max(1.5, r * 0.16);
+  ctx.beginPath();
+  ctx.arc(x, y, r, 0, TAU);
+  ctx.fill();
+  ctx.stroke();
+  ctx.strokeStyle = tono(C.mostaza, -0.3);
+  ctx.lineWidth = Math.max(1, r * 0.12);
+  ctx.beginPath();
+  ctx.arc(x, y, r * 0.62, 0, TAU);
+  ctx.stroke();
+  ctx.fillStyle = tono(C.mostaza, -0.35);
+  ctx.font = F(700, r * 1.05);
+  ctx.textAlign = 'center';
+  ctx.textBaseline = 'middle';
+  ctx.fillText('$', x, y + r * 0.06);
+  ctx.restore();
+}
+
+/** Barra de progreso horizontal con zona marcada. */
+export function barra(ctx, x, y, w, h, v, o = {}) {
+  ctx.save();
+  ctx.fillStyle = o.fondo || '#e6dccd';
+  ctx.strokeStyle = C.tinta;
+  ctx.lineWidth = 2.5;
+  ctx.beginPath();
+  ctx.roundRect(x, y, w, h, h / 2);
+  ctx.fill();
+  ctx.save();
+  ctx.clip();
+  if (o.zona) {
+    ctx.fillStyle = alfa(C.oliva, 0.45);
+    ctx.fillRect(x + w * o.zona[0], y, w * (o.zona[1] - o.zona[0]), h);
+  }
+  ctx.fillStyle = o.color || C.terracota;
+  ctx.fillRect(x, y, w * Math.max(0, Math.min(1, v)), h);
+  ctx.restore();
+  ctx.beginPath();
+  ctx.roundRect(x, y, w, h, h / 2);
+  ctx.stroke();
+  ctx.restore();
+}
+
+/** Panel de papel (tarjetas de puntaje, consejos). */
+export function panel(ctx, x, y, w, h, o = {}) {
+  ctx.save();
+  ctx.fillStyle = 'rgba(59,42,32,.2)';
+  ctx.beginPath();
+  ctx.roundRect(x + 4, y + 7, w, h, o.radio ?? 20);
+  ctx.fill();
+  ctx.fillStyle = o.fondo || C.papel;
+  ctx.strokeStyle = o.borde || C.tinta;
+  ctx.lineWidth = o.grosor || 3;
+  ctx.beginPath();
+  ctx.roundRect(x, y, w, h, o.radio ?? 20);
+  ctx.fill();
+  ctx.stroke();
+  ctx.restore();
+}
+
+/** Carita de humor (para la paciencia de los clientes). */
+export function carita(ctx, x, y, r, animo) {
+  const col = { feliz: C.oliva, normal: C.mostaza, molesto: '#d08a3a', enojado: C.terracota }[animo] || C.oliva;
+  ctx.save();
+  ctx.fillStyle = col;
+  ctx.strokeStyle = C.tinta;
+  ctx.lineWidth = 2;
+  ctx.beginPath();
+  ctx.arc(x, y, r, 0, TAU);
+  ctx.fill();
+  ctx.stroke();
+  ctx.fillStyle = C.tinta;
+  for (const sx of [-1, 1]) {
+    ctx.beginPath();
+    ctx.arc(x + sx * r * 0.35, y - r * 0.2, r * 0.12, 0, TAU);
+    ctx.fill();
+  }
+  ctx.beginPath();
+  if (animo === 'feliz') ctx.arc(x, y + r * 0.05, r * 0.45, 0.2 * Math.PI, 0.8 * Math.PI);
+  else if (animo === 'normal') {
+    ctx.moveTo(x - r * 0.35, y + r * 0.35);
+    ctx.lineTo(x + r * 0.35, y + r * 0.35);
+  } else ctx.arc(x, y + r * 0.75, r * 0.4, 1.2 * Math.PI, 1.8 * Math.PI);
+  ctx.stroke();
+  ctx.restore();
+}
+
+/** Estrellas de 0 a 5 (con medias). */
+export function estrellas(ctx, x, y, r, valor, total = 5) {
+  ctx.save();
+  for (let i = 0; i < total; i++) {
+    const cx = x + i * r * 2.3;
+    const lleno = Math.max(0, Math.min(1, valor - i));
+    estrella(ctx, cx, y, r, '#e6dccd');
+    if (lleno > 0) {
+      ctx.save();
+      ctx.beginPath();
+      ctx.rect(cx - r, y - r, r * 2 * lleno, r * 2);
+      ctx.clip();
+      estrella(ctx, cx, y, r, C.mostaza);
+      ctx.restore();
+    }
+    ctx.lineWidth = 2.5;
+    ctx.strokeStyle = C.tinta;
+    caminoEstrella(ctx, cx, y, r);
+    ctx.stroke();
+  }
+  ctx.restore();
+}
+
+function caminoEstrella(ctx, x, y, r) {
+  ctx.beginPath();
+  for (let i = 0; i < 10; i++) {
+    const a = -Math.PI / 2 + (i * Math.PI) / 5;
+    const rr = i % 2 ? r * 0.45 : r;
+    i ? ctx.lineTo(x + Math.cos(a) * rr, y + Math.sin(a) * rr) : ctx.moveTo(x + Math.cos(a) * rr, y + Math.sin(a) * rr);
+  }
+  ctx.closePath();
+}
+
+function estrella(ctx, x, y, r, col) {
+  caminoEstrella(ctx, x, y, r);
+  ctx.fillStyle = col;
+  ctx.fill();
+}
