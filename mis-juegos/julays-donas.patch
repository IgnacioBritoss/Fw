@@ -0,0 +1,886 @@
+/**
+ * El local: paredes, piso, mesas, mostrador y cada decoración que se puede comprar o ganar.
+ * También los fondos de las estaciones de la cocina. Lienzo lógico de 1280 × 720.
+ */
+import { C, CLIENTES, EXIGENTES } from './data.js';
+import { TAU, tono, alfa, dona, donaIdeal, retrato, azar } from './art.js';
+
+export const W = 1280;
+export const H = 720;
+export const PISO = 470;
+
+/** Dónde se para cada uno en el mostrador (los pies). */
+export const LUGARES = {
+  puerta: { x: 58, y: 636 },
+  caja: { x: 712, y: 636 },
+  // donde se para a buscar su pedido (al lado de la caja)
+  retiro: { x: 814, y: 640 },
+  fila: [
+    { x: 604, y: 640 },
+    { x: 496, y: 643 },
+    { x: 388, y: 646 },
+  ],
+  // sentados a las mesas (los pies quedan atrás de la mesa)
+  asientos: [
+    { x: 150, y: 548, mesa: 0 },
+    { x: 262, y: 548, mesa: 0 },
+    { x: 392, y: 548, mesa: 1 },
+    { x: 504, y: 548, mesa: 1 },
+    { x: 610, y: 538, mesa: -1 },
+    { x: 330, y: 536, mesa: -1 },
+  ],
+  empleado: { x: 1040, y: 528 },
+  mesas: [206, 448],
+};
+
+const lin = (ctx, w = 3, c = C.tinta) => {
+  ctx.lineWidth = w;
+  ctx.strokeStyle = c;
+  ctx.lineJoin = 'round';
+  ctx.lineCap = 'round';
+};
+
+// ------------------------------------------------------------------ paredes y piso
+
+function pared(ctx, id, y0 = 0, y1 = PISO) {
+  ctx.save();
+  ctx.beginPath();
+  ctx.rect(0, y0, W, y1 - y0);
+  ctx.clip();
+  const base = { 'pared-rayas': '#efe0c9', 'pared-lunares': '#f1e4cf', 'pared-azulejos': '#f2ece2', 'pared-ladrillo': '#e9d9c2' }[id] || C.pared;
+  ctx.fillStyle = base;
+  ctx.fillRect(0, y0, W, y1 - y0);
+  if (id === 'pared-rayas') {
+    ctx.fillStyle = '#e4c3ab';
+    for (let x = 0; x < W; x += 64) ctx.fillRect(x, y0, 32, y1 - y0);
+  } else if (id === 'pared-lunares') {
+    ctx.fillStyle = '#e2c4a2';
+    for (let y = y0 + 20, f = 0; y < y1; y += 44, f++)
+      for (let x = (f % 2) * 28 + 14; x < W; x += 56) {
+        ctx.beginPath();
+        ctx.arc(x, y, 6, 0, TAU);
+        ctx.fill();
+      }
+  } else if (id === 'pared-azulejos') {
+    ctx.strokeStyle = '#d8cbb6';
+    ctx.lineWidth = 2;
+    for (let y = y0; y < y1; y += 48) {
+      ctx.beginPath();
+      ctx.moveTo(0, y);
+      ctx.lineTo(W, y);
+      ctx.stroke();
+    }
+    for (let x = 0; x < W; x += 48) {
+      ctx.beginPath();
+      ctx.moveTo(x, y0);
+      ctx.lineTo(x, y1);
+      ctx.stroke();
+    }
+    ctx.fillStyle = alfa(C.petroleo, 0.45);
+    for (let y = y0 + 24, f = 0; y < y1; y += 48, f++)
+      for (let x = 24 + (f % 2) * 48; x < W; x += 96) {
+        ctx.beginPath();
+        ctx.moveTo(x, y - 8);
+        ctx.lineTo(x + 8, y);
+        ctx.lineTo(x, y + 8);
+        ctx.lineTo(x - 8, y);
+        ctx.closePath();
+        ctx.fill();
+      }
+  } else if (id === 'pared-ladrillo') {
+    ctx.fillStyle = '#c99274';
+    for (let y = y0, f = 0; y < y1; y += 30, f++)
+      for (let x = (f % 2) * -32; x < W; x += 64) {
+        ctx.beginPath();
+        ctx.roundRect(x + 3, y + 3, 58, 24, 3);
+        ctx.fill();
+      }
+  }
+  ctx.restore();
+}
+
+function piso(ctx, id, y0 = PISO, y1 = H) {
+  ctx.save();
+  ctx.beginPath();
+  ctx.rect(0, y0, W, y1 - y0);
+  ctx.clip();
+  if (id === 'piso-madera') {
+    ctx.fillStyle = '#b88a5e';
+    ctx.fillRect(0, y0, W, y1 - y0);
+    ctx.strokeStyle = '#9b7049';
+    ctx.lineWidth = 2;
+    for (let y = y0, f = 0; y < y1; y += 26, f++) {
+      ctx.beginPath();
+      ctx.moveTo(0, y);
+      ctx.lineTo(W, y);
+      ctx.stroke();
+      for (let x = (f % 3) * 70; x < W; x += 210) {
+        ctx.beginPath();
+        ctx.moveTo(x, y);
+        ctx.lineTo(x, y + 26);
+        ctx.stroke();
+      }
+    }
+  } else if (id === 'piso-calcareo') {
+    ctx.fillStyle = '#ecdfc8';
+    ctx.fillRect(0, y0, W, y1 - y0);
+    for (let y = y0, f = 0; y < y1; y += 46, f++)
+      for (let x = 0; x < W; x += 64) {
+        ctx.strokeStyle = '#d5c4a8';
+        ctx.lineWidth = 2;
+        ctx.strokeRect(x, y, 64, 46);
+        ctx.fillStyle = alfa(C.terracota, 0.55);
+        ctx.beginPath();
+        ctx.ellipse(x + 32, y + 23, 14, 9, 0, 0, TAU);
+        ctx.fill();
+        ctx.fillStyle = alfa(C.oliva, 0.6);
+        for (const [dx, dy] of [[0, 0], [64, 0], [0, 46], [64, 46]]) {
+          ctx.beginPath();
+          ctx.ellipse(x + dx, y + dy, 9, 6, 0, 0, TAU);
+          ctx.fill();
+        }
+      }
+  } else {
+    // damero
+    ctx.fillStyle = '#e6d6bb';
+    ctx.fillRect(0, y0, W, y1 - y0);
+    ctx.fillStyle = '#c4a184';
+    for (let y = y0, f = 0; y < y1; y += 32, f++) for (let x = (f % 2) * 56; x < W; x += 112) ctx.fillRect(x, y, 56, 32);
+  }
+  // sombra del zócalo
+  ctx.fillStyle = 'rgba(59,42,32,.12)';
+  ctx.fillRect(0, y0, W, 10);
+  ctx.restore();
+}
+
+// ------------------------------------------------------------------ fondo del salón
+
+/** Pared, ventana, puerta, cartel, cuadros y piso. t = tiempo (para lo que se mueve). */
+export function salon(ctx, deco, t, o = {}) {
+  pared(ctx, deco.pared);
+  // zócalo de madera
+  ctx.fillStyle = C.madera3;
+  ctx.fillRect(0, PISO - 54, W, 54);
+  ctx.fillStyle = tono(C.madera3, -0.15);
+  for (let x = 20; x < W; x += 90) ctx.fillRect(x, PISO - 46, 60, 38);
+  lin(ctx, 3);
+  ctx.beginPath();
+  ctx.moveTo(0, PISO - 54);
+  ctx.lineTo(W, PISO - 54);
+  ctx.stroke();
+  piso(ctx, deco.piso);
+  ventana(ctx, 110, 172, 220, 160, t);
+  puerta(ctx, 10, 214, 96, PISO - 214, o.campana);
+  cartel(ctx, 1040, 168, o.cartel);
+  estanteria(ctx, 860, 214, 380, 190, t);
+  techo(ctx, deco.techo, t);
+  cuadro(ctx, deco.cuadro, 405, 240, t);
+  estante(ctx, deco.estante, 572, 230, t);
+}
+
+function ventana(ctx, x, y, w, h, t) {
+  ctx.save();
+  ctx.beginPath();
+  ctx.rect(x, y, w, h);
+  ctx.clip();
+  ctx.fillStyle = '#cfe0e6';
+  ctx.fillRect(x, y, w, h);
+  ctx.fillStyle = '#f4ead8';
+  ctx.beginPath();
+  ctx.arc(x + w * 0.78, y + 34, 18, 0, TAU);
+  ctx.fill();
+  // casitas del barrio
+  const casas = [[0, 70, '#c99274'], [46, 52, '#d4a017'], [88, 80, '#9aa88a'], [140, 60, '#c47a8a'], [182, 74, '#b88a5e']];
+  for (const [dx, hh, col] of casas) {
+    ctx.fillStyle = col;
+    ctx.fillRect(x + dx, y + h - hh, 44, hh);
+    ctx.fillStyle = alfa('#fbf5ea', 0.7);
+    for (let i = 0; i < 2; i++) ctx.fillRect(x + dx + 8 + i * 18, y + h - hh + 12, 10, 12);
+  }
+  // un pajarito que pasa
+  const px = x + ((t * 30) % (w + 60)) - 30;
+  lin(ctx, 2);
+  ctx.beginPath();
+  ctx.moveTo(px - 6, y + 50);
+  ctx.quadraticCurveTo(px - 3, y + 45, px, y + 50);
+  ctx.quadraticCurveTo(px + 3, y + 45, px + 6, y + 50);
+  ctx.stroke();
+  ctx.restore();
+  lin(ctx, 6, C.madera2);
+  ctx.strokeRect(x, y, w, h);
+  lin(ctx, 4, C.madera2);
+  ctx.beginPath();
+  ctx.moveTo(x + w / 2, y);
+  ctx.lineTo(x + w / 2, y + h);
+  ctx.stroke();
+  // toldito
+  for (let i = 0; i < 7; i++) {
+    ctx.fillStyle = i % 2 ? C.crema : C.terracota;
+    ctx.beginPath();
+    const bx = x - 8 + i * ((w + 16) / 7);
+    const bw = (w + 16) / 7;
+    ctx.moveTo(bx, y - 16);
+    ctx.lineTo(bx + bw, y - 16);
+    ctx.lineTo(bx + bw, y + 6);
+    ctx.quadraticCurveTo(bx + bw / 2, y + 16, bx, y + 6);
+    ctx.closePath();
+    ctx.fill();
+  }
+  lin(ctx, 3);
+  ctx.strokeRect(x - 8, y - 16, w + 16, 22);
+}
+
+function puerta(ctx, x, y, w, h, campana) {
+  ctx.fillStyle = C.madera;
+  ctx.fillRect(x, y, w, h);
+  ctx.fillStyle = '#cfe0e6';
+  ctx.fillRect(x + 14, y + 16, w - 28, h * 0.42);
+  lin(ctx, 3);
+  ctx.strokeRect(x, y, w, h);
+  ctx.strokeRect(x + 14, y + 16, w - 28, h * 0.42);
+  ctx.fillStyle = C.mostaza;
+  ctx.beginPath();
+  ctx.arc(x + w - 16, y + h * 0.6, 5, 0, TAU);
+  ctx.fill();
+  ctx.stroke();
+  // cartelito de abierto
+  ctx.fillStyle = C.crema;
+  ctx.beginPath();
+  ctx.roundRect(x + 16, y + h * 0.48, w - 32, 22, 4);
+  ctx.fill();
+  ctx.stroke();
+  ctx.fillStyle = C.oliva;
+  ctx.font = '700 12px Fredoka, "Trebuchet MS", sans-serif';
+  ctx.textAlign = 'center';
+  ctx.textBaseline = 'middle';
+  ctx.fillText('ABIERTO', x + w / 2, y + h * 0.48 + 11);
+  // campanita de la puerta
+  ctx.save();
+  ctx.translate(x + w / 2, y - 2);
+  ctx.rotate(campana ? Math.sin(campana * 30) * 0.4 * campana : 0);
+  ctx.fillStyle = C.mostaza;
+  ctx.beginPath();
+  ctx.moveTo(-9, 18);
+  ctx.quadraticCurveTo(-9, 2, 0, 2);
+  ctx.quadraticCurveTo(9, 2, 9, 18);
+  ctx.closePath();
+  ctx.fill();
+  ctx.stroke();
+  ctx.restore();
+}
+
+/** El cartel del local. texto: por si cambia en el final. */
+export function cartel(ctx, cx, cy, texto) {
+  const w = 380;
+  const h = 70;
+  ctx.save();
+  ctx.fillStyle = C.terracota;
+  ctx.beginPath();
+  ctx.roundRect(cx - w / 2, cy - h / 2, w, h, 16);
+  ctx.fill();
+  lin(ctx, 4);
+  ctx.stroke();
+  ctx.fillStyle = C.crema;
+  ctx.beginPath();
+  ctx.roundRect(cx - w / 2 + 8, cy - h / 2 + 8, w - 16, h - 16, 10);
+  ctx.lineWidth = 2;
+  ctx.strokeStyle = C.crema;
+  ctx.stroke();
+  ctx.font = '700 34px Fredoka, "Trebuchet MS", sans-serif';
+  ctx.textAlign = 'center';
+  ctx.textBaseline = 'middle';
+  ctx.fillText(texto || 'Julay’s Donas', cx + 18, cy + 2);
+  dona(ctx, donaIdeal({ masa: 'vainilla', forma: 'anillo', relleno: null, bano: 'frutilla', hilos: null, toppings: ['granas'], pieza: null }), cx - w / 2 + 44, cy, 22, { sombra: false });
