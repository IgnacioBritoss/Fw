+/**
+ * Las viñetas de la historia (el principio y el final), dibujadas con tu personaje y con Julay.
+ * Cada escena ocupa un lienzo de 960 × 420.
+ */
+import { C, JULAY } from './data.js';
+import { TAU, persona, dona, donaIdeal, tono } from './art.js';
+import { salon, mostrador, cartel, mesas } from './local.js';
+
+export const EW = 960;
+export const EH = 420;
+
+const DONA_ROSA = { masa: 'vainilla', forma: 'anillo', relleno: null, bano: 'frutilla', hilos: null, toppings: ['granas'], pieza: null };
+
+function valija(ctx, x, y, s = 1, col = C.petroleo) {
+  ctx.save();
+  ctx.translate(x, y);
+  ctx.scale(s, s);
+  ctx.lineWidth = 3;
+  ctx.strokeStyle = C.tinta;
+  ctx.fillStyle = col;
+  ctx.beginPath();
+  ctx.roundRect(-38, -62, 76, 62, 8);
+  ctx.fill();
+  ctx.stroke();
+  ctx.beginPath();
+  ctx.roundRect(-14, -74, 28, 14, 6);
+  ctx.stroke();
+  ctx.fillStyle = C.mostaza;
+  ctx.fillRect(-38, -38, 76, 8);
+  ctx.strokeRect(-38, -38, 76, 8);
+  ctx.fillStyle = C.crema;
+  ctx.beginPath();
+  ctx.arc(18, -50, 7, 0, TAU);
+  ctx.fill();
+  ctx.restore();
+}
+
+function interior(ctx, deco, t) {
+  ctx.save();
+  ctx.scale(EW / 1280, EW / 1280);
+  ctx.translate(0, -120);
+  salon(ctx, deco, t);
+  mesas(ctx, deco.mesas);
+  ctx.restore();
+}
+
+function fachada(ctx, t, texto) {
+  // cielo, veredas y el frente del local
+  ctx.fillStyle = '#cfe0e6';
+  ctx.fillRect(0, 0, EW, EH);
+  ctx.fillStyle = '#f4ead8';
+  ctx.beginPath();
+  ctx.arc(820, 70, 34, 0, TAU);
+  ctx.fill();
+  const casas = [[0, 180, '#c99274'], [150, 150, '#9aa88a'], [700, 170, '#c47a8a'], [840, 200, '#b88a5e']];
+  for (const [x, h, col] of casas) {
+    ctx.fillStyle = col;
+    ctx.fillRect(x, 320 - h, 140, h);
+    ctx.fillStyle = 'rgba(251,245,234,.7)';
+    for (let i = 0; i < 3; i++) for (let j = 0; j < 2; j++) ctx.fillRect(x + 18 + i * 40, 320 - h + 22 + j * 46, 22, 26);
+  }
+  // el local
+  ctx.lineWidth = 4;
+  ctx.strokeStyle = C.tinta;
+  ctx.fillStyle = C.pared;
+  ctx.fillRect(300, 70, 380, 250);
+  ctx.strokeRect(300, 70, 380, 250);
+  for (let i = 0; i < 10; i++) {
+    ctx.fillStyle = i % 2 ? C.crema : C.terracota;
+    ctx.beginPath();
+    ctx.moveTo(290 + i * 40, 150);
+    ctx.lineTo(330 + i * 40, 150);
+    ctx.lineTo(330 + i * 40, 180);
+    ctx.quadraticCurveTo(310 + i * 40, 194, 290 + i * 40, 180);
+    ctx.closePath();
+    ctx.fill();
+  }
+  ctx.strokeRect(290, 150, 400, 32);
+  ctx.save();
+  ctx.translate(490, 108);
+  ctx.scale(0.86, 0.86);
+  cartel(ctx, 0, 0, texto);
+  ctx.restore();
+  ctx.fillStyle = '#cfe0e6';
+  ctx.fillRect(320, 200, 160, 100);
+  ctx.strokeRect(320, 200, 160, 100);
+  dona(ctx, donaIdeal(DONA_ROSA), 370, 260, 24, { sombra: false });
+  dona(ctx, donaIdeal({ ...DONA_ROSA, bano: 'choco' }), 430, 262, 24, { sombra: false });
+  ctx.fillStyle = C.madera;
+  ctx.fillRect(540, 200, 90, 120);
+  ctx.strokeRect(540, 200, 90, 120);
+  // vereda
+  ctx.fillStyle = '#d6cbbb';
+  ctx.fillRect(0, 320, EW, EH - 320);
+  ctx.strokeStyle = '#bdb1a0';
+  ctx.lineWidth = 2;
+  for (let x = 0; x < EW; x += 80) {
+    ctx.beginPath();
+    ctx.moveTo(x, 320);
+    ctx.lineTo(x - 30, EH);
+    ctx.stroke();
+  }
+  ctx.strokeStyle = C.tinta;
+  ctx.lineWidth = 3;
+  ctx.beginPath();
+  ctx.moveTo(0, 320);
+  ctx.lineTo(EW, 320);
+  ctx.stroke();
+}
+
+function nubeDona(ctx, x, y) {
+  ctx.save();
+  ctx.fillStyle = C.papel;
+  ctx.strokeStyle = C.tinta;
+  ctx.lineWidth = 3;
+  for (const [dx, dy, r] of [[0, 0, 44], [36, 8, 32], [-36, 10, 30]]) {
+    ctx.beginPath();
+    ctx.arc(x + dx, y + dy, r, 0, TAU);
+    ctx.fill();
+    ctx.stroke();
+  }
+  ctx.beginPath();
+  ctx.arc(x + 10, y + 10, 40, 0, TAU);
+  ctx.fill();
+  for (const [dx, dy, r] of [[-30, 58, 9], [-44, 76, 6]]) {
+    ctx.beginPath();
+    ctx.arc(x + dx, y + dy, r, 0, TAU);
+    ctx.fill();
+    ctx.stroke();
+  }
+  dona(ctx, donaIdeal(DONA_ROSA), x + 4, y + 6, 26, { sombra: false });
+  ctx.restore();
+}
+
+/** Dibuja la escena `id`. yo: tu aspecto (sin delantal); t: tiempo para animar. */
+export function escena(ctx, id, yo, deco, t = 0) {
+  ctx.save();
+  ctx.clearRect(0, 0, EW, EH);
+  const conDelantal = { ...yo, apron: yo.apron || C.crema };
+  const sinDelantal = { ...yo, apron: null };
+  const julay = JULAY.look;
+  if (id === 'calle') {
+    fachada(ctx, t);
+    persona(ctx, sinDelantal, 190, 392, 1.05, { t, animo: 'encantado' });
+    valija(ctx, 262, 392, 1);
+    nubeDona(ctx, 118, 96);
+  } else if (id === 'valija') {
+    interior(ctx, deco, t);
+    persona(ctx, julay, 560, 400, 1.1, { t, animo: 'feliz', pose: 'valija' });
+    valija(ctx, 650, 400, 1.15, C.terracota);
+    persona(ctx, sinDelantal, 170, 400, 1.05, { t, animo: 'sorpresa' });
+  } else if (id === 'pregunta') {
+    interior(ctx, deco, t);
+    persona(ctx, julay, 600, 430, 1.35, { t, animo: 'sorpresa' });
+    persona(ctx, sinDelantal, 340, 430, 1.35, { t, animo: 'feliz' });
+    ctx.fillStyle = C.terracota;
+    ctx.font = '700 60px Fredoka, sans-serif';
+    ctx.textAlign = 'center';
+    ctx.fillText('?', 690 + Math.sin(t * 3) * 4, 90);
+  } else if (id === 'llaves') {
+    interior(ctx, deco, t);
+    persona(ctx, julay, 580, 430, 1.35, { t, animo: 'encantado', pose: 'llaves' });
+    persona(ctx, conDelantal, 330, 430, 1.35, { t, animo: 'encantado' });
+  } else if (id === 'despedida') {
+    interior(ctx, deco, t);
+    ctx.save();
+    ctx.scale(EW / 1280, EW / 1280);
+    ctx.translate(0, -120);
+    persona(ctx, conDelantal, 1040, 528, 1, { t, animo: 'feliz', pose: 'saluda' });
+    mostrador(ctx, deco, t);
+    ctx.restore();
+    persona(ctx, julay, 150, 400, 1.05, { t, animo: 'encantado', pose: 'saluda' });
+    valija(ctx, 235, 400, 1.05, C.terracota);
+  } else if (id === 'final-1') {
+    interior(ctx, deco, t);
+    persona(ctx, julay, 560, 430, 1.35, { t, animo: 'encantado' });
+    dona(ctx, donaIdeal({ masa: 'chocolate', forma: 'anillo', relleno: null, bano: 'ddl', hilos: 'blanco', toppings: ['granas'], pieza: { id: 'frutilla', n: 4 } }), 660, 250, 46);
+    persona(ctx, conDelantal, 300, 430, 1.35, { t, animo: 'feliz' });
+    // lagrimitas de felicidad
+    ctx.fillStyle = '#9fc6d8';
+    for (const dx of [-16, 16]) {
+      ctx.beginPath();
+      ctx.ellipse(560 + dx, 148 + ((t * 30) % 20), 4, 7, 0, 0, TAU);
+      ctx.fill();
+    }
+  } else if (id === 'final-2') {
+    fachada(ctx, t, 'Julay’s Donas ★');
+    persona(ctx, julay, 380, 400, 1.05, { t, animo: 'encantado', pose: 'saluda' });
+    persona(ctx, conDelantal, 600, 400, 1.05, { t, animo: 'encantado', pose: 'saluda' });
+    const cols = [C.terracota, C.mostaza, C.oliva, C.petroleo, C.rosa];
+    for (let i = 0; i < 40; i++) {
+      const x = (i * 97 + t * 40 * (1 + (i % 3))) % EW;
+      const y = (i * 53 + t * 70 * (1 + (i % 2))) % EH;
+      ctx.fillStyle = cols[i % 5];
+      ctx.save();
+      ctx.translate(x, y);
+      ctx.rotate(t * 3 + i);
+      ctx.fillRect(-6, -3, 12, 6);
+      ctx.restore();
+    }
+  }
+  ctx.restore();
+}
diff --git a/public/games/julays-donas/fritura.js b/public/games/julays-donas/fritura.js
