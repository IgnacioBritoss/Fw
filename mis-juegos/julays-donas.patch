+  const p = P[i];
+  const texto = J.tr(p).replaceAll('{n}', J.save.nombre || 'Juli');
+  const el = mostrar(
+    `<div class="tarjeta historia">
+      <canvas class="vineta"></canvas>
+      <div class="lado">
+        <p class="texto">${esc(texto).replace(/\n/g, '<br>')}</p>
+        <div class="botones">
+          <span class="puntos">${P.map((_, k) => `<i class="${k === i ? 'on' : ''}"></i>`).join('')}</span>
+          ${i < P.length - 1 ? `<button class="b" data-a="saltar">${J.tr(TXT.saltar)}</button>` : ''}
+          <button class="b primario" data-a="sig">${i < P.length - 1 ? J.tr(TXT.siguiente) : J.tr(TXT.abrir)}</button>
+        </div>
+      </div>
+    </div>`,
+    'con-fondo',
+  );
+  const cv = el.querySelector('.vineta');
+  let t = 0;
+  const loop = () => {
+    t += 0.016;
+    lienzo(cv, EW, EH, (ctx) => escena(ctx, p.escena, J.save.look, J.save.deco, t));
+    anim = requestAnimationFrame(loop);
+  };
+  loop();
+  on('[data-a="sig"]', 'click', () => {
+    J.snd('click');
+    if (i < P.length - 1) historia(J, paneles, o, i + 1);
+    else o.onFin();
+  });
+  on('[data-a="saltar"]', 'click', () => o.onFin());
