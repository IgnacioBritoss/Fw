+    ctx.fillStyle = C.acero;
+    ctx.beginPath();
+    ctx.ellipse(x, 156, 16, 9, 0, 0, TAU);
+    ctx.fill();
+    ctx.stroke();
+  }
+  ctx.restore();
+}
+
+function marco(ctx, x, y, w, h, color = C.madera2) {
