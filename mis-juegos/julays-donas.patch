+/** El exigente de cada día: Julay cada 7 días; si no, los que ya aparecieron, rotando. */
+export function exigenteDelDia(day) {
+  if (day % 7 === 0) return JULAY;
+  const ya = EXIGENTES.filter((e) => e.day <= day);
+  return ya[(day - 1) % ya.length];
+}
