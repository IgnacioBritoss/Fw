+  const info = {
+    n: d.n,
+    resultados: res,
+    ganado: res.reduce((a, r) => a + r.propina, 0),
+    promedio: Math.round(res.reduce((a, r) => a + r.total, 0) / Math.max(1, res.length)),
+    logros: J.logrosHoy || [],
