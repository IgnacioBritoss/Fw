+
+/* ---------- pantallas sobre el canvas ----------
+   Cada pantalla es una tarjeta que nunca pasa el alto de la ventana: arriba y abajo quedan fijos
+   (título y botones) y si algo no entra, scrollea sólo el medio (.cuerpo). Arriba queda libre el
+   lugar de los botones del portal. */
+#ui { position: fixed; inset: 0; z-index: 5; }
+.pantalla { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; padding: calc(56px + env(safe-area-inset-top)) max(16px, env(safe-area-inset-right)) calc(14px + env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left)); }
+.pantalla.con-fondo { background: rgba(43, 33, 27, 0.45); }
+.pantalla.oscuro { background: rgba(43, 33, 27, 0.62); }
+.tarjeta { width: min(760px, 100%); max-height: 100%; overflow-y: auto; overscroll-behavior: contain; touch-action: pan-y; background: var(--papel); border: 3px solid var(--tinta); border-radius: 26px; padding: 22px 24px; box-shadow: 0 8px 0 rgba(59, 42, 32, 0.25); display: flex; flex-direction: column; gap: 12px; }
+.tarjeta > * { flex: none; }
