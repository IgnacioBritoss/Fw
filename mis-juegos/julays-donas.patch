+.cliente small { color: var(--tinta2); font-size: 14px; }
+.cliente.exigente { border-color: var(--terracota); background: #fbeae2; }
+.ingredientes { display: flex; flex-wrap: wrap; gap: 10px; }
+.ingrediente { display: flex; align-items: center; gap: 6px; background: #fff8ec; border: 2.5px solid var(--tinta); border-radius: 14px; padding: 4px 12px 4px 4px; font-weight: 600; }
+.ingrediente canvas { width: 46px; }
+.resumen { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
+.resumen div { background: #fff8ec; border: 2.5px solid var(--tinta); border-radius: 16px; padding: 8px; text-align: center; display: grid; }
+.resumen small { color: var(--tinta2); font-size: 13px; }
+.resumen b { font-size: 28px; display: flex; align-items: center; justify-content: center; gap: 6px; }
+.resumen canvas, .plata canvas { width: 24px; }
+.logros { display: grid; gap: 6px; }
+.logro { background: #eef3e4; border: 2.5px solid var(--oliva); border-radius: 14px; padding: 8px 12px; display: grid; }
+.logro small { color: var(--tinta2); }
+.resultados { display: grid; gap: 6px; align-content: start; max-height: min(330px, calc(var(--alto) - 190px)); overflow-y: auto; overscroll-behavior: contain; touch-action: pan-y; padding-right: 4px; }
+.resultado { display: grid; grid-template-columns: 44px 1fr auto auto; gap: 10px; align-items: center; font-size: 17px; }
+.resultado canvas { width: 40px; }
+.resultado b { font-size: 20px; }
+.resultado em { font-style: normal; color: var(--oliva); font-weight: 700; min-width: 42px; text-align: right; }
+
+/* tienda: arriba el título, la plata y «Listo»; abajo el local de muestra y la lista de cosas */
+.tienda { width: min(1100px, 100%); }
+.cabeza { display: flex; align-items: center; gap: 14px; }
+.cabeza h2 { margin-right: auto; }
+.plata { display: flex; align-items: center; gap: 6px; font-size: 24px; font-weight: 700; }
+.tienda .cuerpo { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 16px; overflow: hidden; }
+.tienda .izq { display: grid; gap: 8px; align-content: start; justify-items: center; }
+.tienda .salon { display: block; width: auto; height: auto; max-width: 100%; max-height: calc(var(--alto) - 190px); border: 3px solid var(--tinta); border-radius: 16px; }
+.tienda .der { position: relative; min-height: 120px; }
