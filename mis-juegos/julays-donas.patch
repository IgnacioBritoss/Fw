+.nombre input { font: 600 20px var(--fuente); color: var(--tinta); background: #fff; border: 3px solid var(--tinta); border-radius: 12px; padding: 8px 12px; width: 100%; min-width: 0; }
+.fila { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 8px; align-items: center; }
+.fila > span { font-weight: 600; font-size: 15px; color: var(--tinta2); }
