+    ctx.arc(x, y - 112, 38, 0, TAU);
+    ctx.fill();
+    ctx.stroke();
+    const cols = [C.mostaza, C.oliva, C.rosa, C.petroleo2, C.terracota, C.crema];
+    const R = azar(4);
+    for (let i = 0; i < 20; i++) {
+      const a = R() * TAU;
+      const rr = R() * 28;
+      ctx.fillStyle = cols[i % cols.length];
+      ctx.beginPath();
+      ctx.arc(x + Math.cos(a) * rr, y - 108 + Math.abs(Math.sin(a)) * rr * 0.8, 7, 0, TAU);
