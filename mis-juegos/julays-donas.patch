+.vestidor .persona { width: auto; height: auto; max-width: 300px; max-height: calc(var(--alto) - 140px); background: #f7efe1; border: 3px solid var(--tinta); border-radius: 20px; }
+.vestidor .ajustes { flex: 1 1 auto; min-width: 0; min-height: 0; display: flex; flex-direction: column; gap: 12px; }
