+  .cliente b { font-size: 15px; }
+  .cliente small { font-size: 12px; }
+  .ingredientes { gap: 6px; }
+  .ingrediente { font-size: 13px; padding: 2px 10px 2px 2px; border-width: 2px; border-radius: 12px; }
+  .ingrediente canvas { width: 34px; }
+  .resumen { gap: 6px; }
+  .resumen div { padding: 4px; border-width: 2px; border-radius: 12px; }
+  .resumen small { font-size: 11px; }
+  .resumen b { font-size: 20px; }
+  .resumen canvas, .plata canvas { width: 18px; }
+  .logro { padding: 4px 10px; border-width: 2px; font-size: 13px; }
+  .logro small { font-size: 11px; }
+  .resultados { gap: 4px; max-height: calc(var(--alto) - 128px); }
+  .resultado { grid-template-columns: 32px 1fr auto auto; gap: 8px; font-size: 14px; }
+  .resultado canvas { width: 30px; }
+  .resultado b { font-size: 16px; }
+  .plata { font-size: 18px; }
+  .tienda .salon { max-height: calc(var(--alto) - 116px); border-width: 2.5px; border-radius: 12px; }
+  .items { gap: 6px; }
+  .item { padding: 4px 6px 4px 10px; border-width: 2px; border-radius: 12px; font-size: 14px; }
+  .item small { font-size: 11px; }
+  .paso { font-size: 14px; }
+  .paso p { font-size: 13px; line-height: 1.3; }
+  .teclas { font-size: 12px; }
+}
+/* bajo y ancho: la historia con la viñeta al lado del texto */
+@media (max-height: 520px) and (min-aspect-ratio: 3/2) {
+  .historia { flex-direction: row; align-items: center; width: min(1040px, 100%); }
+  .historia .vineta { max-width: 60%; max-height: calc(var(--alto) - 30px); }
+  .historia .lado { flex: 1 1 0; min-width: 0; }
+  .historia .botones { flex-wrap: wrap; }
+  .historia .puntos { width: 100%; margin: 0 0 4px; }
+}
+/* celulares acostados muy bajos (iPhone SE y parecidos) */
+@media (max-height: 400px) {
+  .logo-dona { width: 60px; }
+  .tarjeta h1 { font-size: 22px; }
+  .tarjeta h2 { font-size: 18px; }
+  .titulo .bajada { font-size: 13px; }
+  .b { font-size: 15px; padding: 6px 14px; }
+  .fila { grid-template-columns: 74px minmax(0, 1fr); }
+  .chip { padding: 3px 9px; }
+  .color { width: 24px; height: 24px; }
+  .vestidor .persona { max-height: calc(var(--alto) - 88px); }
+  .postal p { font-size: 13px; }
+  .tienda .salon { max-height: calc(var(--alto) - 158px); }
+}
