+}
+
+/** Atrás del mostrador: estantes con frascos y donas. */
+function estanteria(ctx, x, y, w, h, t) {
+  ctx.fillStyle = tono(C.madera, 0.25);
+  ctx.fillRect(x, y, w, h);
+  lin(ctx, 3);
+  ctx.strokeRect(x, y, w, h);
+  for (let i = 1; i < 3; i++) {
+    ctx.fillStyle = C.madera;
+    ctx.fillRect(x, y + (h / 3) * i - 6, w, 10);
+    ctx.strokeRect(x, y + (h / 3) * i - 6, w, 10);
+  }
+  // donas en los estantes
+  const tipos = [
+    { masa: 'vainilla', bano: 'choco' },
+    { masa: 'chocolate', bano: 'blanco' },
+    { masa: 'vainilla', bano: 'frutilla' },
+    { masa: 'vainilla', bano: 'ddl' },
+  ];
+  for (let i = 0; i < 6; i++) {
+    const tp = tipos[i % 4];
+    dona(ctx, donaIdeal({ masa: tp.masa, forma: 'anillo', relleno: null, bano: tp.bano, hilos: null, toppings: i % 2 ? ['granas'] : [], pieza: null }), x + 36 + i * 62, y + h / 3 - 22, 20, { sombra: false });
+  }
+  // frascos
+  const cols = [C.mostaza, C.terracota, C.oliva, C.rosa, C.petroleo2];
+  for (let i = 0; i < 5; i++) {
+    const fx = x + 30 + i * 74;
+    const fy = y + (h * 2) / 3 - 10;
+    ctx.fillStyle = 'rgba(246,240,230,.8)';
+    ctx.beginPath();
+    ctx.roundRect(fx - 18, fy - 44, 36, 44, 6);
+    ctx.fill();
+    ctx.stroke();
+    ctx.fillStyle = cols[i];
+    ctx.fillRect(fx - 14, fy - 26, 28, 22);
+    ctx.fillStyle = C.madera2;
+    ctx.fillRect(fx - 20, fy - 52, 40, 9);
+    ctx.strokeRect(fx - 20, fy - 52, 40, 9);
+  }
+  // pizarrita del menú
+  ctx.fillStyle = '#3f4a3c';
+  ctx.beginPath();
+  ctx.roundRect(x + 18, y + h - 54, w - 36, 46, 6);
+  ctx.fill();
+  ctx.stroke();
+  ctx.fillStyle = '#f4ead8';
+  ctx.font = '600 15px Fredoka, "Trebuchet MS", sans-serif';
+  ctx.textAlign = 'center';
+  ctx.textBaseline = 'middle';
+  ctx.fillText('Donas · Bolas · Bastones · Con todo', x + w / 2, y + h - 31);
+}
+
+// ------------------------------------------------------------------ decoraciones
+
+function techo(ctx, id, t) {
+  if (!id) return;
+  ctx.save();
+  if (id === 'banderines') {
+    const cols = [C.terracota, C.mostaza, C.oliva, C.petroleo, C.rosa];
+    lin(ctx, 2);
+    ctx.beginPath();
+    ctx.moveTo(0, 130);
+    ctx.quadraticCurveTo(400, 170, 800, 130);
+    ctx.stroke();
+    for (let i = 0; i < 16; i++) {
+      const x = 20 + i * 50;
+      const tt = x / 800;
+      const y = 130 + 4 * tt * (1 - tt) * 40 * 1;
+      ctx.fillStyle = cols[i % cols.length];
+      ctx.beginPath();
+      ctx.moveTo(x - 16, y);
+      ctx.lineTo(x + 16, y);
+      ctx.lineTo(x, y + 30);
+      ctx.closePath();
+      ctx.fill();
+      ctx.stroke();
+    }
+  } else if (id === 'lamparas') {
+    for (const x of [200, 440, 680]) {
+      lin(ctx, 2);
+      ctx.beginPath();
+      ctx.moveTo(x, 120);
+      ctx.lineTo(x, 168);
+      ctx.stroke();
+      ctx.fillStyle = C.oliva;
+      ctx.beginPath();
+      ctx.moveTo(x - 30, 200);
+      ctx.lineTo(x - 12, 166);
+      ctx.lineTo(x + 12, 166);
+      ctx.lineTo(x + 30, 200);
+      ctx.closePath();
+      ctx.fill();
+      ctx.stroke();
+      ctx.fillStyle = '#f6e7b8';
+      ctx.beginPath();
+      ctx.arc(x, 202, 8, 0, Math.PI);
+      ctx.fill();
+      ctx.stroke();
+    }
+  } else if (id === 'ventilador') {
+    const x = 420;
+    lin(ctx, 3);
+    ctx.beginPath();
+    ctx.moveTo(x, 120);
+    ctx.lineTo(x, 150);
+    ctx.stroke();
+    ctx.fillStyle = C.madera;
+    for (let i = 0; i < 4; i++) {
+      const a = t * 4 + (i * TAU) / 4;
+      ctx.beginPath();
+      ctx.ellipse(x + Math.cos(a) * 60, 158 + Math.sin(a) * 9, 58 * Math.abs(Math.cos(a)) + 8, 7, 0, 0, TAU);
