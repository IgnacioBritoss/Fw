+      g.lineTo(W, y);
+      g.stroke();
+    }
+    for (let x = 0; x < W; x += 40) {
+      g.beginPath();
+      g.moveTo(x, 0);
+      g.lineTo(x, 160);
+      g.stroke();
+    }
+    conGrano(g, 0, 0, W, 160, 0.6);
+    if (tipo === 'fritura') {
+      // acero cepillado
+      g.fillStyle = '#c9c3ba';
+      g.fillRect(0, 140, W, H - 140);
+      g.strokeStyle = 'rgba(255,250,242,.18)';
+      g.lineWidth = 1;
