+  ctx.beginPath();
+  ctx.roundRect(-196, -186, 120, 22, 4);
+  ctx.fill();
+  ctx.fillStyle = C.mostaza2;
+  ctx.font = F(700, 15);
+  ctx.textAlign = 'center';
+  ctx.textBaseline = 'middle';
+  ctx.fillText('AEROPUERTO', -136, -175);
+  ctx.fillStyle = C.tinta;
+  for (const dx of [-130, 130]) {
+    ctx.beginPath();
+    ctx.arc(dx, -16, 26, 0, TAU);
