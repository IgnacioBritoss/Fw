+  ctx.strokeStyle = C.tinta;
+  ctx.lineJoin = 'round';
+  ctx.lineCap = 'round';
+};
+
+/** Dibujo de cada mejora, centrado en (x, y), de unos 200 × 140 a escala 1. */
