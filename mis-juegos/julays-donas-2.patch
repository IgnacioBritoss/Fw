+import { panel, F, parrafo } from './dibujo.js';
+import { icono } from './ticket.js';
+
+const CARTA = { x: 250, y: 132, w: 780, h: 400 };
+
+/** ¿Hay que presentar a este cliente? Devuelve la presentación o null. */
+export function presentar(J, actor) {
+  const def = actor.def;
+  const s = J.save;
+  s.presentados = s.presentados || [];
+  let tipo = null;
+  if (def.julay) tipo = 'julay';
+  else if (actor.exigente) tipo = 'exigente';
+  else if (!s.presentados.includes(def.id)) tipo = 'nuevo';
+  if (!tipo) return null;
+  if (tipo === 'nuevo') s.presentados.push(def.id);
+  // en las pruebas (tiempo acelerado) se ve un instante
+  const dur = (J.vel || 1) > 1 ? 0.5 : tipo === 'nuevo' ? 3.4 : 3.8;
+  return { def, tipo, t: 0, dur, cerrando: false };
+}
+
+/** Tocar la pantalla adelanta el final. */
+export function saltarPresentacion(P) {
+  if (P.t > 0.5 && !P.cerrando) {
+    P.cerrando = true;
+    P.t = Math.max(P.t, P.dur - 0.35);
+  }
+}
+
+const easeOutBack = (k) => {
+  const c = 1.5;
+  return 1 + (c + 1) * Math.pow(k - 1, 3) + c * Math.pow(k - 1, 2);
+};
+const clamp = (v) => Math.max(0, Math.min(1, v));
+
+const ROTULO = {
+  nuevo: { es: '¡CLIENTE NUEVO!', en: 'NEW CUSTOMER!' },
+  exigente: { es: '★ CLIENTE EXIGENTE', en: '★ TOUGH CUSTOMER' },
+  julay: { es: '¡VOLVIÓ JULAY!', en: 'JULAY IS BACK!' },
+};
+const FOCO = {
+  fritura: { es: 'Mira con lupa la fritura.', en: 'Inspects the frying closely.' },
+  decorado: { es: 'Mira con lupa el decorado.', en: 'Inspects the decorating closely.' },
+  masa: { es: 'Mira con lupa la masa.', en: 'Inspects the dough closely.' },
+  espera: { es: 'No le gusta nada esperar.', en: 'Hates waiting.' },
+};
+
+/** Lo que le gusta, para mostrarlo con íconos. */
+function gustos(def) {
+  const out = [];
+  const L = def.likes || {};
+  for (const id of L.masa || []) out.push({ cat: 'masa', id, n: byId(MASAS, id)?.name });
+  for (const id of L.forma || []) out.push({ cat: 'forma', id, n: byId(FORMAS, id)?.name });
+  for (const id of L.relleno || []) out.push({ cat: 'relleno', id, n: byId(RELLENOS, id)?.name });
+  for (const id of L.bano || []) out.push({ cat: 'bano', id, n: byId(BANOS, id)?.name });
+  for (const id of L.hilos || []) out.push({ cat: 'hilos', id, n: byId(HILOS, id)?.name });
+  for (const id of L.topping || []) out.push({ cat: 'topping', id, n: byId(TOPPINGS, id)?.name });
