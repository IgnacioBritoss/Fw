   if (look.style === 'polera') {
     forma((dx) => ctx.roundRect(dx - 13, cuello - 4, 26, 15, 6), tono(look.shirt, -0.06), 0.12, 4);
   }
@@ -571,21 +568,22 @@ function ropa(ctx, look, w, ws, hombro, cadera, b, piel) {
