+  border: 2px solid rgba(255, 255, 255, 0.14);
+  color: #fff7e6;
+  text-align: center;
+}
+.score .h {
+  font-weight: 900;
+  font-size: 11px;
+  letter-spacing: 0.04em;
+  opacity: 0.85;
+  white-space: nowrap;
+}
+.score .n {
+  font: 700 22px Fredoka, sans-serif;
+  line-height: 1;
+}
+/* más grande cuando hay lugar (en el celular acostado queda como estaba, para no tapar a los de los costados) */
+.score.mid {
+  gap: 3px 10px;
+  padding: 8px 10px 9px;
+}
+.score.mid .h {
+  font-size: 13px;
+}
+.score.mid .n {
+  font-size: 27px;
+}
+.score.big {
+  gap: 4px 14px;
+  padding: 10px 14px 12px;
+  border-radius: 18px;
+}
+.score.big .h {
+  font-size: 16px;
+}
+.score.big .n {
+  font-size: 34px;
+}
+.score .n.t0 {
+  color: #9cd0ff;
+}
+.score .n.t1 {
+  color: #ffb39e;
+}
+.score svg {
+  display: block;
+  margin: 2px auto 0;
+}
+.score .flash {
+  animation: flash 0.9s ease-out;
+}
+@keyframes flash {
+  0% {
+    scale: 1.5;
+    color: var(--sun);
+  }
+}
+
+/* resumen de la mano */
+.toast .env-pts {
+  display: block;
+  margin-top: 2px;
+  font: 700 17px Fredoka, sans-serif;
+  color: #2b1306;
+}
+.toast {
+  position: absolute;
+  left: 50%;
+  top: 47%;
+  z-index: 40;
+  min-width: 230px;
+  max-width: calc(100% - 32px);
+  padding: 10px 16px 12px;
+  border-radius: 18px;
+  background: var(--paper);
+  border: 3px solid #2b1306;
+  box-shadow:
+    0 6px 0 #2b1306,
+    0 22px 60px rgba(0, 0, 0, 0.5);
+  text-align: center;
+  translate: -50% -50%;
+  animation: pop 0.35s cubic-bezier(0.2, 1.4, 0.4, 1);
+  pointer-events: none;
+}
+.toast b {
+  display: block;
+  font: 700 22px Fredoka, sans-serif;
+}
+.toast b.t0 {
+  color: var(--pen);
+}
+.toast b.t1 {
+  color: #b33a1d;
+}
+.toast p {
+  margin: 4px 0 0;
+  font-weight: 800;
+  font-size: 13.5px;
+  color: var(--ink2);
+}
+.toast p em {
+  font-style: normal;
+  font-weight: 900;
+  color: var(--ink);
+}
+.toast .proof {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 5px;
+  margin-top: 6px;
+  font-weight: 900;
+  font-size: 12.5px;
+  color: var(--ink2);
+}
+.toast .proof span {
+  margin-right: 3px;
+}
+.toast .proof img {
+  width: 34px;
+  border-radius: 4px;
+  box-shadow:
+    0 0 0 2px var(--sky),
+    0 3px 6px rgba(0, 0, 0, 0.3);
+}
+@keyframes pop {
+  from {
+    opacity: 0;
+    scale: 0.7;
+  }
+}
+
+/* anuncio grande (truco, falta envido, flor) */
+.callout {
+  position: absolute;
+  left: 50%;
+  top: 46%;
+  z-index: 45;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  pointer-events: none;
+  opacity: 0;
+  translate: -50% -50%;
+  scale: 0.6;
+}
+.callout b {
+  font: 700 clamp(40px, 9vw, 76px) Fredoka, sans-serif;
+  color: #fff;
+  -webkit-text-stroke: 2.5px #2b1306;
+  paint-order: stroke fill;
+  text-shadow: 0 6px 0 #2b1306;
+  white-space: nowrap;
+}
+.callout small {
+  margin-top: 2px;
+  padding: 2px 12px;
+  border-radius: 99px;
+  background: rgba(20, 10, 3, 0.75);
+  color: #fff7e6;
+  font-weight: 800;
+  font-size: 15px;
+}
+.callout.truco b {
+  color: #ffb39e;
+}
+.callout.envido b {
+  color: #b7dcff;
+}
+.callout.flor b {
+  color: #ffc4de;
+}
+.callout.gold b {
+  color: var(--sun);
+}
+.callout.on {
+  animation: callout 1.5s cubic-bezier(0.2, 1.2, 0.3, 1) both;
+}
+@keyframes callout {
+  0% {
+    opacity: 0;
+    scale: 0.4;
+    rotate: -8deg;
+  }
+  14% {
+    opacity: 1;
+    scale: 1.12;
+    rotate: 3deg;
+  }
+  24% {
+    scale: 1;
+    rotate: 0deg;
+  }
