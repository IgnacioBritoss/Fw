+    ],
+    { duration: 330, easing: 'cubic-bezier(.2,.8,.3,1)' },
+  );
+}
+function renderHand(v, dealing) {
+  const h = v.hand;
+  const mine = h.mine;
+  const live = !!v.can.play;
