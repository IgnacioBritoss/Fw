+    const backs = el.querySelector('.backs');
+    const k = s.left;
+    if (backs.children.length !== k || dealing) {
+      backs.innerHTML = '';
+      for (let j = 0; j < k; j++) {
+        const img = document.createElement('img');
+        img.src = cardURL(null);
+        img.alt = '';
