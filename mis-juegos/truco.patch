+function caballo(s) {
+  const P = CABALLO[s];
+  const hc = P.horse, hc2 = P.horse2;
+  const tall = s === 'e' || s === 'b';
+  const leg = (d) => `<path d="${d}" fill="${hc}" ${S(1.7)}/>`;
