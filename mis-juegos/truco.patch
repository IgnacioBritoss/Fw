+  box-shadow: 0 3px 0 #2b1306;
+  font: 700 20px Fredoka, sans-serif;
+  color: #2b1306;
+  transition: box-shadow 0.25s;
+}
+.seat.turn .av {
+  box-shadow:
+    0 3px 0 #2b1306,
+    0 0 0 5px rgba(255, 214, 90, 0.85),
+    0 0 22px rgba(255, 214, 90, 0.6);
+  animation: breathe 1.4s ease-in-out infinite;
+}
+@keyframes breathe {
+  50% {
+    scale: 1.06;
+  }
+}
+.seat.away .av {
+  filter: grayscale(0.8);
+  opacity: 0.7;
+}
+.nm {
+  max-width: 120px;
+  padding: 1px 8px;
+  border-radius: 99px;
+  background: rgba(10, 25, 15, 0.6);
+  color: #fff7e6;
+  font-weight: 800;
+  font-size: 12.5px;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.nm small {
+  opacity: 0.7;
+  font-size: 10.5px;
+}
+.backs {
+  position: relative;
+  height: calc(var(--tw) * 0.62 * 1.5);
+  width: calc(var(--tw) * 1.25);
+}
+.backs img {
+  position: absolute;
+  left: 50%;
+  top: 0;
+  width: calc(var(--tw) * 0.62);
+  border-radius: 4px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.4);
+  translate: -50% 0;
+  transform-origin: 50% 120%;
+  transition:
+    transform 0.3s,
+    opacity 0.3s;
+}
+.av .cnt {
+  display: none;
+  position: absolute;
+  right: -10px;
+  bottom: -6px;
+  padding: 0 5px;
+  border-radius: 99px;
+  background: #fff;
+  border: 2px solid #2b1306;
+  font: 700 11px Fredoka, sans-serif;
+}
+.seat.side.narrow .cnt:not(:empty) {
+  display: block;
+}
+.seat.side.narrow .backs {
+  display: none;
+}
+.seat.side.narrow .nm {
+  max-width: 62px;
+  font-size: 11px;
+  padding: 1px 5px;
+}
+.seat.side.narrow .nm small {
+  display: none;
+}
+.seat.side .backs {
+  height: calc(var(--tw) * 0.5 * 1.5);
+}
+.seat.side .backs img {
+  width: calc(var(--tw) * 0.5);
+}
+.chip-mano {
+  position: absolute;
+  right: -16px;
+  top: -6px;
+  padding: 0 6px;
+  border-radius: 99px;
+  background: var(--sun);
+  border: 2px solid #2b1306;
+  font: 700 11px Fredoka, sans-serif;
+}
+.team-dot {
+  position: absolute;
+  left: -6px;
+  bottom: -4px;
+  width: 16px;
+  height: 16px;
+  border-radius: 50%;
+  border: 2px solid #2b1306;
+  background: var(--sky);
+}
+.team-dot.t1 {
+  background: var(--coral);
+}
+
+/* globos de lo que se canta */
+.bubble {
+  position: absolute;
+  z-index: 6;
+  padding: 5px 13px 6px;
+  border-radius: 16px;
+  background: #fff;
+  border: 3px solid #2b1306;
+  box-shadow: 0 4px 0 #2b1306;
+  font: 700 20px Fredoka, sans-serif;
+  white-space: nowrap;
+  pointer-events: none;
+  opacity: 0;
+  scale: 0.5;
+  transition:
+    opacity 0.18s,
+    scale 0.25s cubic-bezier(0.2, 1.6, 0.4, 1);
+}
+.bubble.on {
+  opacity: 1;
+  scale: 1;
+}
+.bubble small {
+  display: block;
+  font: 800 11px Nunito, sans-serif;
+  opacity: 0.7;
+  margin-top: -2px;
+}
+.bubble.truco {
+  background: linear-gradient(180deg, #ff9a7e, var(--coral));
+  font-size: 23px;
+}
+.bubble.envido {
+  background: linear-gradient(180deg, #9cd0ff, var(--sky));
+}
+.bubble.flor {
+  background: linear-gradient(180deg, #ffc4de, var(--rose));
+}
+.bubble.yes {
+  background: linear-gradient(180deg, #8eeacb, var(--mint));
+}
+.bubble.no {
+  background: #e8dfcd;
+}
+.bubble.pts {
+  background: #fff3c4;
+}
+.bubble.mine {
+  left: 50%;
+  bottom: calc(100% + 4px);
+  translate: -50% 0;
+}
+
+/* lo que se jugó */
+.pile {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+}
+
+/* tanteador con fósforos y lo que vale la mano */
+.hud {
+  position: absolute;
+  left: 14px;
+  top: 14px;
+  z-index: 3;
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 8px;
+  pointer-events: none;
+}
+.hud > * {
+  pointer-events: auto;
+}
+.worth {
+  position: absolute;
+  right: 14px;
+  top: 66px;
+  z-index: 3;
+  padding: 3px 11px 4px;
+  border-radius: 99px;
+  background: linear-gradient(180deg, #ff9a7e, var(--coral));
+  border: 2.5px solid #2b1306;
+  box-shadow: 0 3px 0 #2b1306;
+  font: 700 14px Fredoka, sans-serif;
+  white-space: nowrap;
+  animation: pop 0.3s cubic-bezier(0.2, 1.5, 0.4, 1);
+}
+.worth.asking {
+  background: #fff3c4;
+  animation: breathe 1.1s ease-in-out infinite;
+}
+.score {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 2px 8px;
+  padding: 6px 8px 7px;
+  border-radius: 14px;
