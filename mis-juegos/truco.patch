+  }
+
+  /** La flor se canta sola la primera vez que el que la tiene debe jugar o contestar en la primera baza. */
+  singFlor(seat) {
+    const h = this.h;
+    h.flor.sung.push(seat);
+    h.calls.push({ seat, what: 'flor' });
