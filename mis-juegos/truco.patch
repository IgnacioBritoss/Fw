diff --git a/public/shared/daily.js b/public/shared/daily.js
new file mode 100644
index 0000000..a7e9f67
--- /dev/null
+++ b/public/shared/daily.js
@@ -0,0 +1,195 @@
+/**
+ * Infraestructura de los juegos diarios de game.it (Quinteto, Vínculos, Colmena, Banderín…).
+ *
+ * - El desafío cambia a las 00:00 de Argentina para todos (UTC−3 fijo: el país no tiene horario de verano
+ *   desde 2009), así que todos juegan el mismo desafío al mismo tiempo y pueden comparar resultados.
+ * - `dayNumber(epoch)` numera los desafíos: el día `epoch` ("AAAA-MM-DD", el del lanzamiento) es el n.º 1.
+ * - El estado del día y las estadísticas viven en localStorage con el prefijo `gameit:<id>:`, siempre
+ *   dentro de try/catch. Las estadísticas van por idioma porque cada idioma tiene su propio desafío.
+ * - `markPortal` deja un resumen en `gameit:daily:<id>` que lee el menú del portal (mismo origen) para
+ *   mostrar "Nuevo" o "✓ Racha N" en la tarjeta del juego.
+ */
+const DAY = 86400e3;
+const OFFSET = -3 * 3600e3;
+
+// ---------------------------------------------------------------- fechas (hora de Argentina)
+/** "AAAA-MM-DD" del día actual en Argentina. */
+export const today = (now = Date.now()) => new Date(now + OFFSET).toISOString().slice(0, 10);
+
+/** Cantidad de días desde 1970-01-01 de una fecha "AAAA-MM-DD". */
+export const dayIndex = (date) => {
+  const [y, m, d] = String(date).split('-').map(Number);
+  return Math.floor(Date.UTC(y, m - 1, d) / DAY);
+};
+
+/** N.º de desafío de `date`: el día `epoch` es el 1. */
+export const dayNumber = (epoch, date = today()) => dayIndex(date) - dayIndex(epoch) + 1;
+
+/** Milisegundos que faltan para el próximo desafío (la medianoche de Argentina). */
+export const msUntilNext = (now = Date.now()) => DAY - ((((now + OFFSET) % DAY) + DAY) % DAY);
+
+export function fmtClock(ms) {
+  const s = Math.max(0, Math.ceil(ms / 1000));
+  const p = (n) => String(n).padStart(2, '0');
+  return `${p(Math.floor(s / 3600))}:${p(Math.floor((s % 3600) / 60))}:${p(s % 60)}`;
+}
+
+/** Pinta la cuenta regresiva al próximo desafío en `el`. Devuelve la función que la detiene. */
+export function countdown(el, onZero) {
+  let iv = 0;
+  const tick = () => {
+    const ms = msUntilNext();
+    el.textContent = fmtClock(ms);
+    if (ms < 1000) {
+      clearInterval(iv);
+      onZero?.();
+    }
+  };
+  tick();
+  iv = setInterval(tick, 500);
+  return () => clearInterval(iv);
+}
+
+/** Avisa cuando cambia el día mientras la pestaña sigue abierta (o al volver a ella). */
+export function onNewDay(cb) {
+  let d = today();
+  const check = () => {
+    const n = today();
+    if (n !== d) {
+      d = n;
+      cb(n);
+    }
+  };
+  const iv = setInterval(check, 15000);
+  document.addEventListener('visibilitychange', check);
+  return () => {
+    clearInterval(iv);
+    document.removeEventListener('visibilitychange', check);
+  };
+}
+
+// ---------------------------------------------------------------- números al azar con semilla
+/** cyrb128: de un texto a cuatro enteros de 32 bits. */
+export function hash128(str) {
+  let h1 = 1779033703;
+  let h2 = 3144134277;
+  let h3 = 1013904242;
+  let h4 = 2773480762;
+  for (let i = 0, k; i < str.length; i++) {
+    k = str.charCodeAt(i);
+    h1 = h2 ^ Math.imul(h1 ^ k, 597399067);
+    h2 = h3 ^ Math.imul(h2 ^ k, 2869860233);
+    h3 = h4 ^ Math.imul(h3 ^ k, 951274213);
+    h4 = h1 ^ Math.imul(h4 ^ k, 2716044179);
+  }
+  h1 = Math.imul(h3 ^ (h1 >>> 18), 597399067);
+  h2 = Math.imul(h4 ^ (h2 >>> 22), 2869860233);
+  h3 = Math.imul(h1 ^ (h3 >>> 17), 951274213);
+  h4 = Math.imul(h2 ^ (h4 >>> 19), 2716044179);
+  return [(h1 ^ h2 ^ h3 ^ h4) >>> 0, (h2 ^ h1) >>> 0, (h3 ^ h1) >>> 0, (h4 ^ h1) >>> 0];
+}
+
+/** Generador sfc32 sembrado con un texto (p. ej. `${id}:${fecha}`): mismo texto, misma secuencia en todos los navegadores. */
+export function rng(seed) {
+  let [a, b, c, d] = hash128(String(seed));
+  return () => {
+    a >>>= 0;
+    b >>>= 0;
+    c >>>= 0;
+    d >>>= 0;
+    let t = (a + b) | 0;
+    a = b ^ (b >>> 9);
+    b = (c + (c << 3)) | 0;
+    c = (c << 21) | (c >>> 11);
+    d = (d + 1) | 0;
+    t = (t + d) | 0;
+    c = (c + t) | 0;
+    return (t >>> 0) / 4294967296;
+  };
+}
+export const rint = (r, n) => Math.floor(r() * n);
+export const pick = (r, arr) => arr[rint(r, arr.length)];
+export function shuffle(r, arr) {
+  const a = arr.slice();
+  for (let i = a.length - 1; i > 0; i--) {
+    const j = rint(r, i + 1);
+    [a[i], a[j]] = [a[j], a[i]];
+  }
+  return a;
+}
+
+// ---------------------------------------------------------------- guardado
+const read = (k, d) => {
+  try {
+    const v = JSON.parse(globalThis.localStorage.getItem(k));
+    return v ?? d;
+  } catch {
+    return d;
+  }
+};
+const write = (k, v) => {
+  try {
+    globalThis.localStorage.setItem(k, JSON.stringify(v));
+  } catch {}
+};
+
+/** Estado guardado del día (solo vale el del día actual). */
+export function loadDay(id, lang, date = today()) {
+  const v = read(`gameit:${id}:day:${lang}`, null);
+  return v && v.date === date ? v : null;
+}
+export const saveDay = (id, lang, state, date = today()) => write(`gameit:${id}:day:${lang}`, { ...state, date });
+
+const emptyStats = () => ({ played: 0, won: 0, streak: 0, best: 0, last: null, lastWon: null, dist: {} });
+export const loadStats = (id, lang) => ({ ...emptyStats(), ...read(`gameit:${id}:stats:${lang}`, {}) });
+
+/** Racha vigente: cuenta solo si se ganó hoy o ayer. */
+export function liveStreak(stats, date = today()) {
+  return stats.lastWon && dayIndex(date) - dayIndex(stats.lastWon) <= 1 ? stats.streak : 0;
+}
+
+/**
+ * Registra el resultado de un día (una sola vez por día). `score` es lo que se reparte en el histograma
+ * (intentos usados, errores, rango…). Devuelve las estadísticas ya actualizadas.
+ */
+export function record(id, lang, { date = today(), won, score }) {
+  const s = loadStats(id, lang);
+  if (s.last === date) return s;
+  s.played++;
+  s.last = date;
+  if (won) {
+    s.won++;
+    s.streak = s.lastWon && dayIndex(date) - dayIndex(s.lastWon) === 1 ? s.streak + 1 : 1;
+    s.lastWon = date;
+    s.best = Math.max(s.best, s.streak);
+    if (score !== undefined) s.dist[score] = (s.dist[score] || 0) + 1;
+  } else s.streak = 0;
+  write(`gameit:${id}:stats:${lang}`, s);
+  return s;
+}
+
+/** Resumen para la tarjeta del menú del portal. */
+export function markPortal(id, { date = today(), done, won, streak = 0 }) {
+  write(`gameit:daily:${id}`, { date, done: !!done, won: !!won, streak: streak | 0 });
+}
+export const readPortal = (id) => read(`gameit:daily:${id}`, null);
+
+// ---------------------------------------------------------------- compartir
+/** Copia el texto (o abre el menú de compartir en celulares). Devuelve 'shared' | 'copied' | 'failed'. */
+export async function share(text) {
+  try {
+    if (navigator.share && matchMedia('(pointer: coarse)').matches) {
+      await navigator.share({ text });
+      return 'shared';
+    }
+    await navigator.clipboard.writeText(text);
+    return 'copied';
+  } catch {
+    return 'failed';
+  }
+}
+
+export const shareLink = (id) => `${location.origin}/#play/${id}`;
+
+/** Idioma de las preferencias del portal. */
+export const lang = () => (globalThis.GameIt?.prefs?.lang === 'en' ? 'en' : 'es');
diff --git a/public/shared/spanish-deck.js b/public/shared/spanish-deck.js
new file mode 100644
index 0000000..3c18fe3
--- /dev/null
+++ b/public/shared/spanish-deck.js
@@ -0,0 +1,428 @@
+/**
+ * La baraja española de 40 cartas dibujada en SVG (la usan Truco, Escoba y los demás juegos de naipes), copiando el
+ * naipe clásico que se juega en Argentina: colores planos y vivos con contorno negro, números negros en las esquinas,
+ * oros con su flor, copas rojas, amarillas y verdes, espadas celestes con puño rojo, bastos verdes y rojos con nudos,
+ * las pintas (los cortes del marco que dicen el palo: ninguno los oros, uno las copas, dos las espadas, tres los
+ * bastos), los anchos grandes y la sota, el caballo y el rey de cuerpo entero.
+ * Una carta es un texto con el número y el palo ('1e' ancho de espadas, '7o', '12c', '4b'; e espadas · b bastos ·
+ * o oros · c copas). Cada carta es una imagen (data URI) que se arma una sola vez.
+ */
+const num = (c) => parseInt(c, 10);
+const suit = (c) => c[c.length - 1];
+const f = (v) => +(+v).toFixed(2);
+
+const W = 200, H = 300;
+/** Colores del naipe. */
+const C = {
+  line: '#151210',
+  yellow: '#f8e03a', yellow2: '#e3b521',
+  red: '#e2332a', red2: '#a81d16',
+  green: '#63ba45', green2: '#2c8a3a',
+  sky: '#36aee4', sky2: '#1b72b4', sky3: '#b9e4f8',
+  blue: '#2f5fb8', blue2: '#1d3f86',
+  skin: '#fcdcbc', skin2: '#e7ad8a', cheek: '#f39a86',
+  white: '#ffffff', paper: '#fffefb',
+  brown: '#9a5a26', hair: '#5a3418', beard: '#8a5a32',
+  horse: '#f2c13e', horse2: '#c98a22', mane: '#a2551f',
+  ribbon: '#bfe6f6',
+};
+
+const S = (w = 1.8) => `stroke="${C.line}" stroke-width="${w}" stroke-linejoin="round" stroke-linecap="round"`;
+const g = (x, y, r, k, body) => `<g transform="translate(${f(x)},${f(y)})${r ? ` rotate(${f(r)})` : ''}${k !== 1 ? ` scale(${f(k)})` : ''}">${body}</g>`;
+const ring = (n, r, fn) => Array.from({ length: n }, (_, i) => fn(Math.cos((i / n) * Math.PI * 2 - Math.PI / 2) * r, Math.sin((i / n) * Math.PI * 2 - Math.PI / 2) * r, i)).join('');
+
+// ---------------------------------------------------------------- los palos (centrados en 0,0)
+/** Una flor de pétalos redondos (la de los oros). */
+function flower(r, petals, fill, mid, k = 0.42) {
+  const pr = r * k;
+  return `${ring(petals, r - pr, (x, y) => `<circle cx="${f(x)}" cy="${f(y)}" r="${f(pr)}" fill="${fill}" ${S(1.2)}/>`)}<circle r="${f(r * 0.42)}" fill="${mid}" ${S(1.2)}/>`;
+}
+/** Oro (radio 30): moneda amarilla con un anillo y la flor en el centro con su punto. */
+function oro() {
+  return `<circle r="30" fill="${C.yellow}" ${S(2)}/>
+  <circle r="25" fill="none" ${S(1.2)}/>
+  ${ring(16, 27.5, (x, y) => `<path d="M${f(x * 0.93)},${f(y * 0.93)} L${f(x * 1.04)},${f(y * 1.04)}" ${S(1)}/>`)}
+  ${flower(19, 8, C.yellow, C.yellow, 0.4)}
+  <circle r="2.6" fill="${C.line}"/>`;
+}
+/** Copa (alto 64): boca roja, cuerpo amarillo, nudo verde y pie amarillo con borde verde. */
+function copa() {
+  return `<path d="M-24,-26 C-25,-6 -14,6 -5,8 H5 C14,6 25,-6 24,-26 Z" fill="${C.yellow}" ${S(2)}/>
+  <path d="M-23.6,-20 C-23,-14 -21.5,-10 -19,-7 H19 C21.5,-10 23,-14 23.6,-20 Z" fill="${C.red}" ${S(1.3)}/>
+  <path d="M-12,-7 Q0,4 12,-7" fill="none" ${S(1.2)}/>
+  <ellipse cy="-26" rx="24" ry="6" fill="${C.red}" ${S(2)}/>
+  <ellipse cy="-25" rx="17" ry="3" fill="${C.red2}"/>
+  <path d="M-5,8 H5 L4,13 H-4 Z" fill="${C.yellow}" ${S(1.5)}/>
+  <ellipse cy="15.5" rx="8.5" ry="4" fill="${C.green}" ${S(1.5)}/>
+  <path d="M-4,19 H4 L5,23 H-5 Z" fill="${C.yellow}" ${S(1.5)}/>
+  <path d="M-5,23 C-8,27 -18,28 -20,32 H20 C18,28 8,27 5,23 Z" fill="${C.yellow}" ${S(1.8)}/>
+  <path d="M-20,32 H20 V34.5 H-20 Z" fill="${C.green}" ${S(1.5)}/>`;
+}
+/** Espada de largo L con la punta arriba (el pomo en y = L/2): hoja celeste, gavilán amarillo y puño rojo. */
+function espada(L = 200, w = 1) {
+  const t = -L / 2;
+  const gy = L / 2 - 30 * w; // gavilán
+  const bw = 4.6 * w;
+  return `<path d="M0,${f(t)} L${f(bw)},${f(t + 10 * w)} V${f(gy)} H${f(-bw)} V${f(t + 10 * w)} Z" fill="${C.sky}" ${S(1.6)}/>
+  <path d="M${f(-bw * 0.3)},${f(t + 12 * w)} V${f(gy - 3)}" stroke="${C.sky3}" stroke-width="${f(1.6 * w)}" stroke-linecap="round"/>
+  <path d="M${f(-15 * w)},${f(gy - 3 * w)} Q${f(-17 * w)},${f(gy + 4 * w)} ${f(-10 * w)},${f(gy + 4 * w)} H${f(10 * w)} Q${f(17 * w)},${f(gy + 4 * w)} ${f(15 * w)},${f(gy - 3 * w)} Q${f(8 * w)},${f(gy + 1 * w)} 0,${f(gy + 1 * w)} Q${f(-8 * w)},${f(gy + 1 * w)} ${f(-15 * w)},${f(gy - 3 * w)} Z" fill="${C.yellow}" ${S(1.4)}/>
+  <path d="M${f(-4 * w)},${f(gy + 4 * w)} H${f(4 * w)} L${f(3.4 * w)},${f(gy + 20 * w)} H${f(-3.4 * w)} Z" fill="${C.red}" ${S(1.4)}/>
+  <path d="M${f(-3.6 * w)},${f(gy + 9 * w)} H${f(3.6 * w)} M${f(-3.4 * w)},${f(gy + 14 * w)} H${f(3.4 * w)}" ${S(1)}/>
+  <circle cy="${f(gy + 24.5 * w)}" r="${f(4.8 * w)}" fill="${C.yellow}" ${S(1.4)}/>`;
+}
+/** Basto de largo L, grueso arriba y fino en el mango, con nudos; `red`: el rojo con nudos verdes (se alternan). */
+function basto(L = 200, w = 1, red = false) {
+  const t = -L / 2, b = L / 2;
+  const hw = 11 * w, lw = 5 * w;
+  const body = red ? C.red : C.green, knot = red ? C.green : C.red, dark = red ? C.red2 : C.green2;
+  const at = (k) => hw - (hw - lw) * k; // medio ancho a una fracción del largo (desde arriba)
+  // el contorno con bultos: los nudos sobresalen de un lado y del otro
+  const ks = [0.18, 0.38, 0.58, 0.78];
+  const side = (sg) =>
+    ks
+      .map((k, i) => {
+        const y = t + L * k;
+        const a = at(k);
+        const out = sg === (i % 2 ? 1 : -1) ? 5 * w : 2 * w;
