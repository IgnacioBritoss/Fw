@@ -0,0 +1,1260 @@
+/* Truco — una mesa de boliche: paño verde, borde de madera, naipes españoles y los porotos con fósforos */
+:root {
+  --wood: #2a170b;
+  --wood2: #5a3418;
+  --felt: #1d7a4e;
+  --paper: #fbf6e9;
+  --paper2: #f1e8d2;
+  --ink: #2b2118;
+  --ink2: #6d5c48;
+  --line: #d9cbb0;
+  --sun: #ffc93c;
+  --coral: #ff7a59;
+  --mint: #4fd1a5;
+  --sky: #6fb7ff;
+  --rose: #ff9ec7;
+  --red: #d8432f;
+  --pen: #1d3fa8;
+  --hw: 96px; /* ancho de una carta en la mano (lo ajusta game.js) */
+  --tw: 66px; /* ancho de una carta en la mesa */
+  --safe-b: env(safe-area-inset-bottom, 0px);
+}
+[hidden] {
+  display: none !important;
+}
+* {
+  box-sizing: border-box;
+}
+html,
+body {
+  margin: 0;
+  height: 100%;
+  overflow: hidden;
+  font-family: Nunito, system-ui, sans-serif;
+  color: var(--ink);
+  -webkit-user-select: none;
+  user-select: none;
+  -webkit-tap-highlight-color: transparent;
+}
+body {
+  background:
+    radial-gradient(ellipse at 50% 30%, #5a3418 0%, #2a170b 62%, #150a03 100%),
+    #2a170b;
+}
+button {
+  font: inherit;
+  color: inherit;
+  cursor: pointer;
+}
+img {
+  -webkit-user-drag: none;
+}
+
+/* ---------------------------------------------------------------- mesa */
+.game {
+  position: fixed;
+  inset: 56px 0 0 0;
+  display: flex;
+  flex-direction: column;
+}
+.game::before {
+  content: '';
+  position: absolute;
+  inset: 6px 6px 0;
+  border-radius: 30px 30px 0 0;
+  background:
+    radial-gradient(ellipse at 50% 42%, rgba(255, 255, 255, 0.07), transparent 60%),
+    repeating-linear-gradient(45deg, rgba(0, 0, 0, 0.025) 0 2px, transparent 2px 5px),
+    radial-gradient(ellipse at 50% 45%, #22895a 0%, #19693f 58%, #0f4a2c 100%);
+  box-shadow:
+    inset 0 0 0 7px #6b3f1d,
+    inset 0 0 0 9px #2a170b,
+    inset 0 0 0 11px rgba(255, 210, 140, 0.18),
+    inset 0 0 70px rgba(0, 0, 0, 0.5);
+}
+.table {
+  position: relative;
+  flex: 1;
+  min-height: 0;
+}
+.me {
+  position: relative;
+  flex: none;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  padding: 0 12px calc(4px + var(--safe-b));
+}
+body:not(.playing) .me,
+body:not(.playing) .score,
+body:not(.playing) .pause,
+body:not(.playing) .seats {
+  display: none;
+}
+
+/* naipes */
+.naipe {
+  position: absolute;
+  left: 0;
+  top: 0;
+  width: var(--w, var(--tw));
+  aspect-ratio: 2 / 3;
+  border-radius: calc(var(--w, var(--tw)) * 0.075);
+  box-shadow:
+    0 2px 0 rgba(0, 0, 0, 0.25),
+    0 6px 14px rgba(0, 0, 0, 0.32);
+  translate: -50% -50%;
+  transition:
+    filter 0.35s,
+    box-shadow 0.35s,
+    opacity 0.35s;
+}
+.naipe img {
+  display: block;
+  width: 100%;
+  height: 100%;
+  pointer-events: none;
+}
+.pile .naipe.won {
+  box-shadow:
+    0 0 0 3px rgba(255, 214, 90, 0.95),
+    0 0 18px rgba(255, 214, 90, 0.55),
+    0 6px 14px rgba(0, 0, 0, 0.32);
+}
+.pile .naipe.lost {
+  filter: brightness(0.66) saturate(0.7);
+}
+.pile .naipe.parda {
+  box-shadow:
+    0 0 0 3px rgba(255, 255, 255, 0.75),
+    0 6px 14px rgba(0, 0, 0, 0.32);
+}
+.pile .naipe.proof {
+  box-shadow:
+    0 0 0 3px var(--sky),
+    0 0 18px rgba(111, 183, 255, 0.6);
+}
+.naipe .tagp {
+  position: absolute;
+  left: 50%;
+  bottom: -9px;
+  translate: -50% 0;
+  padding: 1px 7px;
+  border-radius: 99px;
+  background: #fff;
+  border: 2px solid #2b1306;
+  font: 700 11px Fredoka, sans-serif;
+  white-space: nowrap;
+}
+
+/* el mazo para repartir */
+.deck {
+  position: absolute;
+  width: calc(var(--tw) * 0.8);
+  aspect-ratio: 2 / 3;
+  pointer-events: none;
+}
+.deck img {
