+        const buenas = b.buenas ?? b.pts === null;
+        later(1450, () => bubble(v, b.seat, t(buenas ? 'c_buenas' : 'c_mejores', { p: b.pts ?? '?' }), buenas ? 'no' : 'pts', '', 2400));
