# Variables del front. En Vercel se cargan en Settings -> Environment Variables.
# Todo lo que empieza con VITE_ queda DENTRO del JavaScript que se descarga
# cualquier visitante: aca no va ninguna clave SECRETA, solo direcciones y la
# clave publica de Stripe, que es publica justamente porque viaja ahi.

# Backend principal (cuentas, autos, reservas, pagos, identidad).
# Vacio = https://free-wheel-back.vercel.app
VITE_API_URL=

# Servicio de IA propio (repo freewheel-ia): el asistente, el autocompletado de
# especificaciones y de precio, la revision de la foto del auto y las notas de
# voz. La verificacion de DNI y licencia NO pasa por aca: esa sigue en el
# backend principal.
#
# Vacio = todo sigue yendo al backend principal, como antes. Por eso se puede
# subir el front antes de publicar el servicio sin que se rompa nada.
VITE_IA_URL=

# Clave PUBLICA de Stripe (pk_test_... / pk_live_...). Es la que usa el
# navegador para cobrar contra un intento que creo el servidor; cobrar de
# verdad necesita la clave SECRETA, que vive en el backend.
#
# Vacio = se usa la clave de PRUEBA que viene escrita en services/stripe.js,
# asi que el sitio publicado cobra sin cargar nada a mano. Se carga aca el dia
# que se pase a cobrar de verdad, y ese dia la clave NO se escribe en el
# codigo.
#
# `off` apaga el cobro con tarjeta y vuelve al camino simulado, que solo
# funciona con el backend levantado con PAYMENTS_PROVIDER=mock.
VITE_STRIPE_PUBLISHABLE_KEY=
