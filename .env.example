# Variables del front. En Vercel se cargan en Settings -> Environment Variables.
# Todo lo que empieza con VITE_ queda DENTRO del JavaScript que se descarga
# cualquier visitante: aca no va ninguna clave, solo direcciones.

# Backend principal (cuentas, autos, reservas, pagos, identidad).
# Vacio = https://free-wheel-back.vercel.app
VITE_API_URL=

# Servicio de IA propio (repo freewheel-ia): el asistente, el autocompletado de
# especificaciones y de precio, la revision de la foto del auto y las notas de
# voz. La verificacion de DNI y licencia NO pasa por aca: esa sigue en el
# backend principal.
#
# Vacio = todo sigue yendo al backend principal, como antes. Por eso se puede
# subir el front antes de publicar el servicio sin que se rompa nada.
VITE_IA_URL=
